   const list = (k: keyof ItemInput) => { if (b[k] !== undefined && b[k] !== null) { if (!Array.isArray(b[k])) return `${k} doit etre un tableau`; (input as Record<string, unknown>)[k] = (b[k] as unknown[]).map(String).map((s) => s.trim()).filter(Boolean); } return null; };
   for (const e of [str("functionalId"), str("instanceId"), str("identityId"), str("message"), str("title"), str("target"), int("delta", 0), int("nbLikes", 0), int("nbBoosts", 0), list("likeGroupIds"), list("boostGroupIds")]) if (e) return { input: null, error: e };
