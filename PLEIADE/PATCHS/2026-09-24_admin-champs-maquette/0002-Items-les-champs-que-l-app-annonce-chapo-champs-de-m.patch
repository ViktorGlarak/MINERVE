+/** Relit les champs annonces par une app ; une entree mal formee est ignoree, jamais devinee. */
+function readItemFields(raw: unknown): ItemField[] {
+  if (!Array.isArray(raw)) return [];
+  const out: ItemField[] = [];
+  for (const f of raw) {
+    if (!f || typeof f !== "object") continue;
+    const o = f as Record<string, unknown>;
+    const key = typeof o.key === "string" ? o.key : "";
+    if (!/^[a-z][a-z0-9_]{0,30}$/.test(key) || out.some((x) => x.key === key)) continue;
+    const type = o.type === "textarea" || o.type === "checkbox" ? o.type : "text";
+    out.push({
+      key, type,
+      label: typeof o.label === "string" && o.label ? o.label : key,
+      hint: typeof o.hint === "string" ? o.hint : "",
+      placeholder: typeof o.placeholder === "string" ? o.placeholder : undefined,
+      group: typeof o.group === "string" ? o.group : "",
+    });
+  }
+  return out;
+}
