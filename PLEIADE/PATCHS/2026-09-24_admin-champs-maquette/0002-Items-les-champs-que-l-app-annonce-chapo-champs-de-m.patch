+/** Les champs supplementaires d'un item, relus depuis la base (JSON). Illisibles : aucun. */
+export function parseFields(raw: string | null | undefined): Record<string, string> {
+  if (!raw) return {};
+  try {
+    const o = JSON.parse(raw);
+    if (!o || typeof o !== "object" || Array.isArray(o)) return {};
+    return Object.fromEntries(Object.entries(o).filter(([, v]) => typeof v === "string")) as Record<string, string>;
+  } catch { return {}; }
+}
