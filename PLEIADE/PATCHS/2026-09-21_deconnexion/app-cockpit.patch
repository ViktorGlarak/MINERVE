+++ b/src/lib/deconnexion.ts
@@ -0,0 +1,61 @@
+"use server";
+
+import { headers } from "next/headers";
+import { redirect } from "next/navigation";
+import { auth, signOut, PUBLIC_ISSUER, KC_CLIENT_ID } from "./auth";
+
+/** La page de connexion de l'app — où l'on revient une fois tout fermé. */
+const PAGE_CONNEXION = "/login";
+
+/**
+ * Se déconnecter — de cockpit **et** de Keycloak.
+ *
+ * ⭐ Les deux, et dans cet ordre. Un `signOut` NextAuth nu ne ferme que la
+ * session de l'application : la session du ROYAUME reste ouverte, et le bouton
+ * « se connecter » rouvre alors le même compte sans rien demander. Impossible
+ * de changer de compte, sur un poste partagé comme pour un essai. Symptôme
+ * rencontré par l'utilisateur sur le serveur (2026-09-21), sur eho d'abord.
+ *
+ * Keycloak clôt sa session sur `end_session_endpoint`, avec le jeton
+ * d'identité en indice (`id_token_hint`, sans lequel il demande une
+ * confirmation), l'identifiant du client et l'adresse où revenir. Même geste
+ * que Pléiade pour son tableau de bord, que LEAC et qu'eho — validé de bout en
+ * bout sur eho (Playwright, Keycloak local) le 2026-09-21.
+ *
+ * ⚠ Fermer la session de ZONE déconnecte de toutes les apps de la zone : sur
+ * un poste partagé, c'est précisément ce qu'on veut. Elle ne remonte PAS à la
+ * session d'organisateur (royaume cecpc) : Pléiade pose le fournisseur
+ * « cecpc » sans adresse de fin de session (décision du 2026-09-21).
+ *
+ * Utilisable en `action` de formulaire comme en `onClick` : l'argument
+ * éventuel (un `FormData`) est ignoré.
+ */
+export async function deconnexion(): Promise<never> {
+  const session = await auth();
+  const idToken = (session as { idToken?: string } | null)?.idToken;
+
+  // ⚠ D'abord l'app — le cookie doit tomber AVANT de quitter le domaine.
+  if (session) await signOut({ redirect: false });
+
+  // Sans jeton d'identité, il n'y a pas de session Keycloak à clore.
+  if (!idToken) redirect(PAGE_CONNEXION);
+
+  const retour = `${await origine()}${PAGE_CONNEXION}`;
+  const fin = new URL(`${PUBLIC_ISSUER}/protocol/openid-connect/logout`);
+  fin.searchParams.set("id_token_hint", idToken);
+  fin.searchParams.set("client_id", KC_CLIENT_ID);
+  if (retour.startsWith("http")) fin.searchParams.set("post_logout_redirect_uri", retour);
+  redirect(fin.toString());
+}
+
+/**
+ * L'adresse publique de l'app, telle que le navigateur la voit. Derrière
+ * Traefik elle vient des en-têtes `X-Forwarded-*` (l'hôte réel n'est pas celui
+ * du conteneur) ; en local, de `Host`. On ne dépend pas d'un `NEXTAUTH_URL`.
+ */
+async function origine(): Promise<string> {
+  const h = await headers();
+  const proto = (h.get("x-forwarded-proto") || "http").split(",")[0].trim();
+  const host = (h.get("x-forwarded-host") || h.get("host") || "").split(",")[0].trim();
+  return host ? `${proto}://${host}` : "";
+}
