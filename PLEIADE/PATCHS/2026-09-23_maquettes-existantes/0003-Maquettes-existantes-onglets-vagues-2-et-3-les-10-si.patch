+++ b/src/skins/hexagone/Hexagone.tsx
@@ -0,0 +1,267 @@
+import Link from "next/link";
+import type { Card } from "@/components/site/data";
+import type { SiteConfig } from "@/lib/site";
+import { CopyLink, NavLink } from "../client";
+import { Img, Notice, captionOf, dates, domainOf, href, skinRoot } from "../shared";
+import type { ArticleProps, HomeProps, ListProps, PageProps, ShellProps, SkinViews } from "../types";
+
+/**
+ * Hexagone — chaine d'information en continu.
+ *
+ * Reprise de Sites/Site Hexagone/_TEMPLATE.html : ruban noir (date, liens),
+ * en-tete blanc au logo hexagonal et au nom rouge, pastille « En direct » et
+ * recherche, navigation noire soulignee de rouge, barre « Derniere minute »,
+ * page blanche centree, photo de tete barree du bandeau facon plateau tele
+ * (« Edition speciale », cartouche bleu, titre sur fond saumon), titres en
+ * capitales Oswald, texte en Lora. Le logo, embarque en base64 dans le
+ * template, est servi par l'instance (public/skins/hexagone-logo.png).
+ */
+
+const LOGO = "/skins/hexagone-logo.png";
+
+function logoSrc(site: SiteConfig) {
+  return site.logoUrl || LOGO;
+}
+
+function Shell({ site, nav, pages, ticker, children }: ShellProps) {
+  const root = skinRoot(site, "hexagone");
+  const d = dates(site);
+  const now = new Date();
+  const domaine = domainOf(site.baseline) || domainOf(site.footerText);
+  const derniere = ticker[0];
+
+  return (
+    <div className={root.className} style={root.style}>
+      <Notice site={site} />
+
+      <div className="top-ribbon">
+        <span>{d.full(now)} &nbsp;·&nbsp; {d.time(now).replace(":", "h")} CEST{domaine && <> &nbsp;·&nbsp; {domaine}</>}</span>
+        <span>
+          <Link href="/direct">En direct</Link>
+          <Link href="/recherche">Dernières infos</Link>
+          {pages.slice(0, 2).map((p) => <Link key={p.slug} href={`/page/${p.slug}`}>{p.title}</Link>)}
+        </span>
+      </div>
+
+      <div className="header-band">
+        <div className="header-inner">
+          <Link className="logo-wrap" href="/">
+            {/* eslint-disable-next-line @next/next/no-img-element */}
+            <img src={logoSrc(site)} alt="" width={54} height={54} className="hex-logo" />
+            <div>
+              <div className="logo-name">{site.name.toUpperCase()}</div>
+              <div className="logo-sub">{site.description || site.baseline}</div>
+            </div>
+          </Link>
+          <div className="header-right">
+            <Link className="badge-live" href="/direct">● EN DIRECT</Link>
+            <form className="header-search" action="/recherche" method="get" role="search">
+              <input type="search" name="q" placeholder="Rechercher…" aria-label="Rechercher un article" />
+              <button type="submit" aria-label="Lancer la recherche">🔍</button>
+            </form>
+          </div>
+        </div>
+      </div>
+
+      <nav className="main-nav" aria-label="Rubriques">
+        <div className="nav-inner">
+          <NavLink href="/">Accueil</NavLink>
+          {nav.map((m) => <NavLink key={`${m.href}-${m.label}`} href={m.href}>{m.label}</NavLink>)}
+          <NavLink href="/direct">▶ En direct</NavLink>
+        </div>
+      </nav>
+
+      {derniere && (
+        <div className="breaking-bar">
+          <div className="breaking-inner">
+            <div className="breaking-label">Dernière minute</div>
+            <Link className="breaking-text" href={`/article/${derniere.slug}`}>{derniere.title}</Link>
+          </div>
+        </div>
+      )}
+
+      <main className="page-outer" id="contenu">{children}</main>
+
+      <footer className="hex-footer">
+        <div className="footer-inner">
+          <div>
+            <div className="footer-logo">{site.name.toUpperCase()}</div>
+            <div className="footer-sub">{[site.description, domaine].filter(Boolean).join("  ·  ")}</div>
+          </div>
+          <div className="footer-links">
+            {pages.map((p) => <Link key={p.slug} href={`/page/${p.slug}`}>{p.title}</Link>)}
+            <Link href="/recherche">Rechercher</Link>
+          </div>
+        </div>
+        <div className="footer-copy">{site.footerText || `© ${now.getFullYear()} ${site.name} — Tous droits réservés`}</div>
+      </footer>
+    </div>
+  );
+}
+
+/** La photo de tete et son bandeau de plateau. Sans photo, pas de bandeau : il n'aurait rien sur quoi se poser. */
+function Hero({ site, card, bandeau, link }: { site: SiteConfig; card: Card; bandeau?: string; link?: boolean }) {
+  if (!card.media) return null;
+  const inner = (
+    <>
+      <Img media={card.media} eager />
+      <div className="bandeau">
+        <div className="bandeau-top">
+          <div className="bandeau-edition">{card.live ? "En direct" : card.urgent ? "Alerte" : "Édition spéciale"}</div>
+          <div className="bandeau-name">{(bandeau || card.category?.name || "À la une").toUpperCase()}</div>
+          <div className="bandeau-logo-wrap">
+            {/* eslint-disable-next-line @next/next/no-img-element */}
+            <img src={logoSrc(site)} alt="" width={28} height={28} />
+            <span className="bandeau-logo-txt">{site.name.toUpperCase()}</span>
+          </div>
+        </div>
+        <div className="bandeau-bottom">{card.title}</div>
+      </div>
+    </>
+  );
+  return link
+    ? <Link className="hero-wrap" href={href(card)} tabIndex={-1} aria-hidden="true">{inner}</Link>
+    : <div className="hero-wrap">{inner}</div>;
+}
+
+function Meta({ site, card, share }: { site: SiteConfig; card: Card; share?: boolean }) {
+  const d = dates(site);
+  return (
+    <div className="art-meta">
+      <span className="meta-src">{site.name}</span>
+      {card.authorName && <span>{card.authorName}</span>}
+      {card.publishedAt && <span>{d.long(card.publishedAt)} · {d.time(card.publishedAt).replace(":", "h")}</span>}
+      {share && (
+        <div className="meta-share">
+          <span className="btn-tw" aria-hidden="true">Twitter</span>
+          <span className="btn-fb" aria-hidden="true">Facebook</span>
+          <CopyLink className="btn-copy" label="Copier le lien" done="Lien copié" />
+        </div>
+      )}
+    </div>
+  );
+}
+
+function Cat({ card }: { card: Card }) {
+  return (
+    <div className="art-cat">
+      {card.urgent && <span className="hex-badge">Alerte</span>}
+      {card.live && <span className="hex-badge">Direct</span>}
+      {card.category ? <Link href={`/rubrique/${card.category.slug}`}>{card.category.name}</Link> : "Actualité"}
+    </div>
+  );
+}
+
+function Tile({ site, card }: { site: SiteConfig; card: Card }) {
+  const d = dates(site);
+  return (
+    <div className="hex-tile">
+      <Link className="hex-tile-img" href={href(card)} tabIndex={-1} aria-hidden="true"><Img media={card.media} /></Link>
+      <div className="hex-tile-body">
+        <div className="hex-tile-cat">{card.category?.name ?? "Actualité"}</div>
+        <Link className="hex-tile-title" href={href(card)}>{card.title}</Link>
+        {card.publishedAt && <div className="hex-tile-date">{d.long(card.publishedAt)} · {d.time(card.publishedAt).replace(":", "h")}</div>}
+      </div>
+    </div>
+  );
+}
+
+function Grid({ site, title, cards }: { site: SiteConfig; title: string; cards: Card[] }) {
+  if (!cards.length) return null;
+  return (
+    <section className="hex-section">
+      <h2 className="hex-section-title">{title}</h2>
+      <div className="hex-grid">{cards.map((c) => <Tile key={c.id} site={site} card={c} />)}</div>
+    </section>
+  );
+}
+
+function Home({ site, lead, cards }: HomeProps) {
+  if (!lead) {
+    return <div className="article-wrap"><div className="art-cat">{site.name}</div><p className="art-deck">Aucun article publié pour l’instant.</p></div>;
+  }
+  return (
+    <>
+      <Hero site={site} card={lead} link />
+      <div className="article-wrap hex-lead">
+        <Cat card={lead} />
+        <h1 className="art-title"><Link href={href(lead)}>{lead.title}</Link></h1>
+        {lead.standfirst && <p className="art-deck">{lead.standfirst}</p>}
+        <Meta site={site} card={lead} />
+      </div>
+      <Grid site={site} title="Dernières infos" cards={cards} />
+    </>
+  );
+}
+
+function Article({ site, article, related, liveNode, reactionsNode }: ArticleProps) {
+  return (
+    <>
+      <Hero site={site} card={article} bandeau={article.fields.bandeau} />
+      <div className="article-wrap">
+        <Cat card={article} />
+        <h1 className="art-title">{article.title}</h1>
+        {article.standfirst && <p className="art-deck">{article.standfirst}</p>}
+        <Meta site={site} card={article} share />
+        {article.media && captionOf(article) && <div className="art-caption">{captionOf(article)}</div>}
+
+        {liveNode && <div className="hex-live">{liveNode}</div>}
+
+        <div className="art-body">
+          <div className="sk-prose" dangerouslySetInnerHTML={{ __html: article.body }} />
+          {article.tags.length > 0 && (
+            <div className="art-tags">
+              <span className="tags-lbl">Mots-clés :</span>
+              {article.tags.map((t) => <Link key={t.slug} className="tag" href={`/recherche?q=${encodeURIComponent(t.name)}`}>{t.name}</Link>)}
+            </div>
+          )}
+        </div>
+
+        <div className="hex-reactions">{reactionsNode}</div>
+      </div>
+      <Grid site={site} title="À voir aussi" cards={related.slice(0, 4)} />
+    </>
+  );
+}
+
+function List({ site, title, subtitle, cards, emptyNote, pager, search }: ListProps) {
+  return (
+    <>
+      <div className="article-wrap hex-list-head">
+        <div className="art-cat">{site.name}</div>
+        <h1 className="art-title">{title}</h1>
+        {subtitle && <div className="hex-count">{subtitle}</div>}
+        {search && (
+          <form className="hex-search" action="/recherche" method="get" role="search">
+            <input type="search" name="q" defaultValue={search.q} placeholder="Un mot, un nom, un lieu…" aria-label="Rechercher" />
+            <button type="submit">Rechercher</button>
+          </form>
+        )}
+      </div>
+      {cards.length === 0
+        ? <div className="article-wrap hex-note">{emptyNote}</div>
+        : <section className="hex-section hex-section-flush"><div className="hex-grid">{cards.map((c) => <Tile key={c.id} site={site} card={c} />)}</div></section>}
+      {pager && (
+        <nav className="hex-pager" aria-label="Pagination">
+          {pager.prev ? <Link href={pager.prev}>‹ Page précédente</Link> : <span />}
+          <span>{pager.label}</span>
+          {pager.next ? <Link href={pager.next}>Page suivante ›</Link> : <span />}
+        </nav>
+      )}
+    </>
+  );
+}
+
+function Page({ site, title, html, updatedAt }: PageProps) {
+  const d = dates(site);
+  return (
+    <div className="article-wrap">
+      <div className="art-cat">{site.name}</div>
+      <h1 className="art-title">{title}</h1>
+      <div className="art-meta"><span>Mise à jour le {d.long(updatedAt)}</span></div>
+      <div className="art-body sk-prose" dangerouslySetInnerHTML={{ __html: html }} />
+    </div>
+  );
+}
+
+export const hexagone: SkinViews = { Shell, Home, Article, List, Page };
