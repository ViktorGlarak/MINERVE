@@ -0,0 +1,216 @@
+import Link from "next/link";
+import type { Card } from "@/components/site/data";
+import type { SiteConfig } from "@/lib/site";
+import { CopyLink } from "../client";
+import { Img, Notice, dates, href, skinRoot } from "../shared";
+import type { ArticleProps, HomeProps, ListProps, PageProps, ShellProps, SkinViews } from "../types";
+
+/**
+ * TF1 Info — grand media televise.
+ *
+ * Reprise de Sites/Site TF1/_TEMPLATE.html : en-tete bleu colle en haut et son
+ * filet bleu vif, logo, pastille rouge « Directs », cloche ; bloc titre bleu
+ * (texte a gauche, image a droite, « Source » en jaune) ; colonne de lecture
+ * etroite avec « L'essentiel » en puces, lettrine, auteur, « Voir plus » et
+ * fil d'Ariane ; pied bleu nuit. Le template n'a pas de navigation visible :
+ * son bouton ☰ ouvre ici le menu des rubriques. Le logo, en base64 dans le
+ * template, est servi par l'instance (public/skins/tf1-logo.jpg).
+ */
+
+const LOGO = "/skins/tf1-logo.jpg";
+
+function Logo({ site, footer }: { site: SiteConfig; footer?: boolean }) {
+  // eslint-disable-next-line @next/next/no-img-element
+  return <img src={site.logoUrl || LOGO} alt={site.name} className={footer ? "tf-logo-img-sm" : "tf-logo-img"} />;
+}
+
+function Shell({ site, nav, pages, ticker, children }: ShellProps) {
+  const root = skinRoot(site, "tf1");
+  const now = new Date();
+
+  return (
+    <div className={root.className} style={root.style}>
+      <Notice site={site} />
+
+      <header className="tf-header">
+        <div className="tf-hd-inner">
+          <Link className="tf-back" href="/" title="Accueil" aria-label="Accueil">&#8592;</Link>
+          <Link className="tf-logo" href="/"><Logo site={site} /></Link>
+          <div className="tf-hd-right">
+            <Link href="/recherche" className="tf-ico" title="Rechercher" aria-label="Rechercher">&#128269;</Link>
+            <Link href="/direct" className="tf-direct"><span className="dot" />DIRECTS</Link>
+            <span className="tf-bell" aria-hidden="true">&#128276;{ticker.length > 0 && <span className="badge">{ticker.length}</span>}</span>
+            <details className="tf-menu">
+              <summary className="tf-ico" title="Menu" aria-label="Menu">&#9776;</summary>
+              <nav className="tf-menu-panel" aria-label="Rubriques">
+                <Link href="/">Accueil</Link>
+                {nav.map((m) => <Link key={`${m.href}-${m.label}`} href={m.href}>{m.label}</Link>)}
+                <Link href="/direct">Directs</Link>
+                <Link href="/recherche">Rechercher</Link>
+              </nav>
+            </details>
+          </div>
+        </div>
+      </header>
+
+      <main id="contenu">{children}</main>
+
+      <footer className="tf-footer">
+        <div className="tf-footer-logo"><Logo site={site} footer /></div>
+        <ul className="tf-footer-links">
+          {nav.map((m) => <li key={`${m.href}-${m.label}`}><Link href={m.href}>{m.label}</Link></li>)}
+          {pages.map((p) => <li key={p.slug}><Link href={`/page/${p.slug}`}>{p.title}</Link></li>)}
+          <li><Link href="/recherche">Tous les articles</Link></li>
+        </ul>
+        <div className="tf-copyright">{site.footerText || `${site.name} Copyright ©${now.getFullYear()}`}</div>
+      </footer>
+    </div>
+  );
+}
+
+/** « 03 juin 2026 à 11h45 », la date telle que TF1 Info l'ecrit. */
+function publie(site: SiteConfig, at: Date) {
+  const d = dates(site);
+  return `le ${d.long(at)} à ${d.time(at).replace(":", "h")}`;
+}
+
+function Hero({ site, card, source, link, as: Titre = "h1" }: { site: SiteConfig; card: Card; source?: string; link?: boolean; as?: "h1" | "h2" }) {
+  const titre = link ? <Link href={href(card)}>{card.title}</Link> : card.title;
+  return (
+    <section className="tf-hero">
+      <div className="tf-hero-inner">
+        <div className="tf-hero-media">
+          <div className="tf-hero-img">
+            {card.media ? <Img media={card.media} eager /> : <span className="ph">{site.name}</span>}
+          </div>
+          {(source || card.credit) && <div className="tf-hero-src"><span className="play" />Source : {source || card.credit}</div>}
+        </div>
+        <div className="tf-hero-txt">
+          {(card.urgent || card.live || card.category) && (
+            <div className="tf-kicker">
+              {card.urgent && <span className="tf-badge">Alerte</span>}
+              {card.live && <span className="tf-badge">En direct</span>}
+              {card.category && <Link href={`/rubrique/${card.category.slug}`}>{card.category.name}</Link>}
+            </div>
+          )}
+          <Titre className="tf-headline">{titre}</Titre>
+          {card.authorName && <div className="tf-byline">Par <span className="tf-author-link">{card.authorName}</span></div>}
+          {card.publishedAt && <div className="tf-pubdate">Publié {publie(site, card.publishedAt)}</div>}
+        </div>
+      </div>
+    </section>
+  );
+}
+
+function Tile({ site, card }: { site: SiteConfig; card: Card }) {
+  const d = dates(site);
+  return (
+    <Link className="tf-card" href={href(card)}>
+      <span className="tf-card-img"><Img media={card.media} /></span>
+      <span className="tf-card-body">
+        {card.category && <span className="tf-card-cat">{card.category.name}</span>}
+        <span className="tf-card-title">{card.title}</span>
+        {card.publishedAt && <span className="tf-card-date">{d.long(card.publishedAt)}</span>}
+      </span>
+    </Link>
+  );
+}
+
+function Home({ site, lead, cards }: HomeProps) {
+  if (!lead) return <div className="tf-main"><p className="tf-note">Aucun article publié pour l’instant.</p></div>;
+  return (
+    <>
+      <Hero site={site} card={lead} link />
+      {lead.standfirst && <div className="tf-main"><p className="tf-lead-deck">{lead.standfirst}</p></div>}
+      {cards.length > 0 && (
+        <section className="tf-list">
+          <h2 className="tf-list-title">À la une</h2>
+          <div className="tf-cards">{cards.map((c) => <Tile key={c.id} site={site} card={c} />)}</div>
+        </section>
+      )}
+    </>
+  );
+}
+
+function Article({ site, article, related, liveNode, reactionsNode }: ArticleProps) {
+  const f = article.fields;
+  const essentiel = [f.essentiel1, f.essentiel2, f.essentiel3].filter(Boolean);
+  return (
+    <>
+      <Hero site={site} card={article} source={f.source} />
+      <div className="tf-main">
+        {essentiel.length > 0 && <ul className="tf-essentiel">{essentiel.map((e, i) => <li key={i}>{e}</li>)}</ul>}
+        {article.standfirst && <p className="tf-intertitle">{article.standfirst}</p>}
+        <CopyLink className="tf-share" label="Partager cet article 🔗" done="Lien copié ✓" />
+        {liveNode && <div className="tf-live">{liveNode}</div>}
+        <div className="tf-body sk-prose" dangerouslySetInnerHTML={{ __html: article.body }} />
+        {article.tags.length > 0 && (
+          <div className="tf-tags">
+            {article.tags.map((t) => <Link key={t.slug} href={`/recherche?q=${encodeURIComponent(t.name)}`}>#{t.name}</Link>)}
+          </div>
+        )}
+        {article.authorName && <div className="tf-author">{article.authorName}</div>}
+        <div className="tf-reactions">{reactionsNode}</div>
+        {related.length > 0 && (
+          <details className="tf-more-wrap">
+            <summary className="tf-more">Voir plus +</summary>
+            <div className="tf-more-list">{related.map((c) => <Tile key={c.id} site={site} card={c} />)}</div>
+          </details>
+        )}
+        <nav className="tf-breadcrumb">
+          <Link href="/">Accueil</Link><span className="sep">-</span>
+          {article.category && <><Link href={`/rubrique/${article.category.slug}`}>{article.category.name}</Link><span className="sep">-</span></>}
+          {article.title}
+        </nav>
+      </div>
+    </>
+  );
+}
+
+function List({ site, title, subtitle, cards, emptyNote, pager, search }: ListProps) {
+  return (
+    <>
+      <section className="tf-hero tf-hero-lite">
+        <div className="tf-hero-inner">
+          <div className="tf-hero-txt">
+            <h1 className="tf-headline">{title}</h1>
+            {subtitle && <div className="tf-pubdate">{subtitle}</div>}
+            {search && (
+              <form className="tf-search" action="/recherche" method="get" role="search">
+                <input type="search" name="q" defaultValue={search.q} placeholder="Rechercher un article…" aria-label="Rechercher" />
+                <button type="submit">Rechercher</button>
+              </form>
+            )}
+          </div>
+        </div>
+      </section>
+      <section className="tf-list">
+        {cards.length === 0 ? <p className="tf-note">{emptyNote}</p> : <div className="tf-cards">{cards.map((c) => <Tile key={c.id} site={site} card={c} />)}</div>}
+        {pager && (
+          <nav className="tf-pager" aria-label="Pagination">
+            {pager.prev ? <Link href={pager.prev}>← Précédent</Link> : <span />}
+            <span>{pager.label}</span>
+            {pager.next ? <Link href={pager.next}>Suivant →</Link> : <span />}
+          </nav>
+        )}
+      </section>
+    </>
+  );
+}
+
+function Page({ site, title, html, updatedAt }: PageProps) {
+  const d = dates(site);
+  return (
+    <>
+      <section className="tf-hero tf-hero-lite">
+        <div className="tf-hero-inner"><div className="tf-hero-txt">
+          <h1 className="tf-headline">{title}</h1>
+          <div className="tf-pubdate">Mis à jour le {d.long(updatedAt)}</div>
+        </div></div>
+      </section>
+      <div className="tf-main"><div className="tf-body tf-body-plain sk-prose" dangerouslySetInnerHTML={{ __html: html }} /></div>
+    </>
+  );
+}
+
+export const tf1: SkinViews = { Shell, Home, Article, List, Page };
