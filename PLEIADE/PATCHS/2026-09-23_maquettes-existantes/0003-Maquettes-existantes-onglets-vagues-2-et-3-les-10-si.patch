+.sk-hexagone .hex-reactions .sk-island { margin-top: 34px; border-top: 3px solid var(--red); padding-top: 18px; }
+.sk-hexagone .hex-count { font-size: 12px; color: var(--grey); text-transform: uppercase; letter-spacing: 0.06em; }
+.sk-hexagone .hex-list-head { padding-bottom: 18px; }
+.sk-hexagone .hex-note { color: var(--grey); font-size: 14px; }
