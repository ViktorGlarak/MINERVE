+++ b/src/skins/onu/onu.css
@@ -0,0 +1,77 @@
+/*
+  Nations Unies — reprise de Sites/Site ONU/_TEMPLATE.html.
+  Confine derriere .sk-onu. Bleu ONU sur --accent, bleu fonce sur
+  --accent-ink, fond autour de la feuille sur --paper, feuille sur --surface.
+  Ajouts : un-nav (ligne de navigation), un-index (liste des communiques).
+*/
+
+.sk-onu {
+  --un-blue: var(--accent);
+  --un-blue-dk: var(--accent-ink);
+  --soft: var(--muted);
+  --bg: var(--paper);
+  --sheet: var(--surface);
+  --un-serif: var(--f-serif), "Source Serif 4", Georgia, serif;
+  --un-sans: var(--f-sourcesans), "Source Sans 3", Arial, sans-serif;
+
+  font-family: var(--un-sans);
+  background: var(--bg);
+  color: var(--ink);
+  font-size: 16px;
+  line-height: normal;
+  min-height: 100vh;
+}
+.sk-onu a { color: var(--un-blue-dk); text-decoration: none; }
+.sk-onu a:hover { text-decoration: underline; }
+
+.sk-onu .un-nav { max-width: 720px; margin: 0 auto; padding: 16px 12px 0; display: flex; flex-wrap: wrap; gap: 4px 18px; font-size: 12px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; }
+.sk-onu .un-nav a { color: var(--soft); }
+.sk-onu .un-nav a.active { color: var(--un-blue-dk); border-bottom: 2px solid var(--un-blue); }
+.sk-onu .un-main { padding: 14px 12px 28px; display: block; }
+
+.sk-onu .doc { max-width: 720px; margin: 0 auto; background: var(--sheet); border: 1px solid var(--rule); box-shadow: 0 4px 22px rgba(0,0,0,0.10); }
+.sk-onu .letterhead { border-top: 6px solid var(--un-blue); padding: 26px 48px 18px; display: flex; align-items: center; gap: 20px; border-bottom: 1px solid var(--rule); }
+.sk-onu .un-emblem { width: 74px; height: 74px; flex-shrink: 0; border: 1px dashed var(--un-blue); border-radius: 50%; display: flex; align-items: center; justify-content: center; text-align: center; color: var(--un-blue-dk); font-size: 18px; font-weight: 700; letter-spacing: 0.06em; background: color-mix(in srgb, var(--un-blue) 6%, #fff); }
+.sk-onu .un-emblem-img { border: 0; background: none; object-fit: contain; }
+.sk-onu .lh-text .org { font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--un-blue-dk); }
+.sk-onu .lh-text .sub { font-size: 11px; color: var(--soft); letter-spacing: 0.08em; text-transform: uppercase; margin-top: 3px; }
+.sk-onu .lh-text .office { font-family: var(--un-serif); font-size: 18px; font-weight: 700; color: var(--ink); margin-top: 7px; }
+.sk-onu .ref-row { display: flex; justify-content: space-between; gap: 12px; padding: 10px 48px; font-size: 11px; color: var(--soft); letter-spacing: 0.03em; background: color-mix(in srgb, var(--paper) 45%, #fff); border-bottom: 1px solid var(--rule); }
+.sk-onu .body { padding: 30px 48px 16px; }
+.sk-onu .doc-kicker { font-size: 10px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--un-blue-dk); margin-bottom: 8px; display: flex; gap: 8px; align-items: center; }
+.sk-onu .un-badge { background: var(--un-blue-dk); color: #fff; padding: 2px 6px; }
+.sk-onu .doc-title { font-family: var(--un-serif); font-size: 23px; font-weight: 700; line-height: 1.3; color: var(--ink); margin: 0 0 22px; }
+.sk-onu .un-lead { font-family: var(--un-serif); font-size: 16px; font-weight: 600; line-height: 1.7; margin: 0 0 16px; }
+.sk-onu .un-body p { font-family: var(--un-serif); font-size: 15.5px; line-height: 1.85; margin: 0 0 16px; text-align: justify; }
+.sk-onu .un-body h2, .sk-onu .un-body h3 { font-family: var(--un-serif); font-size: 17px; font-weight: 700; margin: 24px 0 10px; }
+.sk-onu .un-body ul, .sk-onu .un-body ol { font-family: var(--un-serif); font-size: 15.5px; line-height: 1.8; margin: 0 0 16px 24px; }
+.sk-onu .un-body ul { list-style: disc; }
+.sk-onu .un-body ol { list-style: decimal; }
+.sk-onu .un-body blockquote { border-left: 3px solid var(--un-blue); padding-left: 16px; margin: 18px 0; font-style: italic; }
+.sk-onu .un-body a { text-decoration: underline; }
+.sk-onu .sig { margin: 30px 0 8px; }
+.sk-onu .sig .name { font-family: var(--un-serif); font-size: 17px; font-weight: 700; color: var(--ink); border-top: 1px solid var(--ink); display: inline-block; padding-top: 6px; }
+.sk-onu .sig .title { font-size: 12px; color: var(--soft); margin-top: 3px; }
+.sk-onu .sig .signature-mark { font-family: var(--un-serif); font-style: italic; font-size: 24px; color: var(--un-blue-dk); opacity: 0.65; margin-bottom: 2px; }
+.sk-onu .footer { padding: 14px 48px 24px; border-top: 1px solid var(--rule); font-size: 10px; color: var(--soft); text-align: center; letter-spacing: 0.04em; }
+
+/* ---- Ajouts : liste, recherche, pagination, reactions ------------------ */
+
+.sk-onu .un-index { list-style: none; margin: 8px 0 20px; padding: 0; }
+.sk-onu .un-index li { padding: 16px 0; border-bottom: 1px solid var(--rule); }
+.sk-onu .un-index li:last-child { border-bottom: 0; }
+.sk-onu .un-index-meta { font-size: 11px; color: var(--soft); letter-spacing: 0.04em; display: flex; gap: 14px; margin-bottom: 4px; text-transform: uppercase; }
+.sk-onu .un-index-title { font-family: var(--un-serif); font-size: 18px; font-weight: 700; color: var(--ink); line-height: 1.3; }
+.sk-onu .un-index p { font-family: var(--un-serif); font-size: 14.5px; line-height: 1.6; color: var(--soft); margin: 6px 0 0; }
+.sk-onu .un-search { display: flex; margin: 6px 0 14px; }
+.sk-onu .un-search input { flex: 1; border: 1px solid var(--rule); border-right: 0; padding: 9px 12px; font-size: 14px; font-family: var(--un-sans); outline: none; }
+.sk-onu .un-search button { background: var(--un-blue-dk); color: #fff; border: 0; padding: 0 16px; font-weight: 700; font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; cursor: pointer; }
+.sk-onu .un-pager { display: flex; justify-content: space-between; font-size: 12px; font-weight: 600; margin-bottom: 18px; }
+.sk-onu .un-live { margin-bottom: 20px; }
+.sk-onu .un-reactions { max-width: 720px; margin: 22px auto 0; }
+.sk-onu .un-reactions .sk-island { background: var(--sheet); border: 1px solid var(--rule); padding: 22px 28px; }
+
+@media (max-width: 640px) {
+  .sk-onu .letterhead, .sk-onu .body, .sk-onu .ref-row, .sk-onu .footer { padding-left: 20px; padding-right: 20px; }
+  .sk-onu .ref-row { flex-wrap: wrap; }
+}
