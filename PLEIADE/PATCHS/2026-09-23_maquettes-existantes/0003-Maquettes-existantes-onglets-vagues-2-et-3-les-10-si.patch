+.sk-zubrradio .z-row:hover .z-row-title { color: var(--zubr-amber-lt); }
+.sk-zubrradio .z-row-meta { font-size: 12px; color: var(--zubr-mut); }
+.sk-zubrradio .z-note { color: var(--zubr-mut); }
+.sk-zubrradio .z-tags { display: flex; gap: 12px; flex-wrap: wrap; font-family: var(--z-cond); font-size: 13px; color: var(--zubr-amber); }
+.sk-zubrradio .z-live-feed { margin-bottom: 24px; }
+.sk-zubrradio .z-reactions .sk-island { margin-top: 30px; border-top: 1px solid var(--zubr-rule); padding-top: 18px; }
+.sk-zubrradio .z-search { display: flex; margin-bottom: 18px; }
+.sk-zubrradio .z-search input { flex: 1; background: var(--zubr-panel); border: 1px solid var(--zubr-rule); border-right: 0; color: var(--zubr-text); padding: 10px 12px; font-size: 15px; outline: none; font-family: var(--z-sans); }
+.sk-zubrradio .z-search button { background: var(--zubr-amber); color: var(--accent-ink); border: 0; padding: 0 18px; font-family: var(--z-cond); font-weight: 700; text-transform: uppercase; letter-spacing: .08em; cursor: pointer; }
+.sk-zubrradio .z-pager { display: flex; justify-content: space-between; margin-top: 20px; font-family: var(--z-cond); text-transform: uppercase; font-size: 13px; color: var(--zubr-amber); }
+
+@media (max-width: 680px) {
