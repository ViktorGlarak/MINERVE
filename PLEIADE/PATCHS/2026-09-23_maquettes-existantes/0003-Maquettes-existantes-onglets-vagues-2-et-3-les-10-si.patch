+++ b/src/skins/otan/Otan.tsx
@@ -0,0 +1,238 @@
+import Link from "next/link";
+import type { Card } from "@/components/site/data";
+import type { SiteConfig } from "@/lib/site";
+import { CopyLink, NavLink } from "../client";
+import { Img, Notice, captionOf, dates, href, skinRoot } from "../shared";
+import type { ArticleProps, HomeProps, ListProps, PageProps, ShellProps, SkinViews } from "../types";
+
+/**
+ * OTAN — texte officiel de l'Alliance.
+ *
+ * Reprise de Sites/Site OTAN/OTAN_TEMPLATE.html : en-tete blanc au logo NATO
+ * OTAN et menu a chevrons, recherche et langue ; titre serif bleu sur fond
+ * diagonal, fil d'Ariane, sous-titre, date et temps de lecture ; corps
+ * justifie avec le rail de partage colle a droite ; carte « Abonnez-vous » a
+ * cheval sur le pied marine ; pied en trois colonnes et bandeau au logo. Le
+ * logo (base64 dans le template) est servi par l'instance
+ * (public/skins/otan-logo.png).
+ */
+
+const LOGO = "/skins/otan-logo.png";
+
+function Logo({ site }: { site: SiteConfig }) {
+  // eslint-disable-next-line @next/next/no-img-element
+  return <img src={site.logoUrl || LOGO} alt={site.name} />;
+}
+
+const Caret = () => <span className="caret" aria-hidden="true">&#9662;</span>;
+
+function Shell({ site, nav, pages, children }: ShellProps) {
+  const root = skinRoot(site, "otan");
+  // Le pied du template range ses liens en trois colonnes : on y verse les
+  // rubriques, puis les pages fixes.
+  const liens = [...nav, ...pages.map((p) => ({ label: p.title, href: `/page/${p.slug}` }))];
+  const cols = [0, 1, 2].map((i) => liens.filter((_, j) => j % 3 === i));
+  return (
+    <div className={root.className} style={root.style}>
+      <Notice site={site} />
+
+      <header className="otan-header">
+        <div className="otan-header__inner">
+          <Link className="otan-logo" href="/"><Logo site={site} /></Link>
+          <nav className="otan-nav" aria-label="Rubriques">
+            <NavLink href="/">Accueil</NavLink>
+            {nav.slice(0, 5).map((m) => <NavLink key={`${m.href}-${m.label}`} href={m.href}>{m.label} <Caret /></NavLink>)}
+          </nav>
+          <div className="otan-header__right">
+            <Link className="otan-search" href="/recherche">Recherche
+              <svg className="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><line x1="21" y1="21" x2="16.6" y2="16.6" /></svg>
+            </Link>
+            <span className="otan-lang" aria-hidden="true">Français <Caret /></span>
+          </div>
+        </div>
+      </header>
+
+      <main id="contenu">{children}</main>
+
+      <section className="otan-news" aria-hidden="true">
+        <div className="otan-news__card">
+          <div className="otan-news__t">
+            <h2>Abonnez-vous à<br />nos newsletters</h2>
+            <p>Et recevez régulièrement des mises à jour de l’{site.name}.</p>
+          </div>
+          <div className="otan-news__f">
+            <input type="email" placeholder="Votre adresse e-mail" disabled />
+            <span className="otan-news__btn">S’ABONNER →</span>
+          </div>
+        </div>
+      </section>
+
+      <footer className="otan-footer">
+        <div className="otan-footer__in">
+          <div className="otan-footer__cols">
+            {cols.map((c, i) => (
+              <div key={i}>{c.map((m) => <Link key={`${m.href}-${m.label}`} href={m.href}>{m.label}</Link>)}</div>
+            ))}
+          </div>
+          <div className="otan-footer__bottom">
+            <Logo site={site} />
+            <span className="otan-footer__brand">{site.footerText || site.baseline || site.name}</span>
+          </div>
+        </div>
+      </footer>
+    </div>
+  );
+}
+
+function Hero({ site, crumbs, title, subtitle, card, link }: {
+  site: SiteConfig; crumbs: Array<{ label: string; href?: string }>; title: string; subtitle?: string; card?: Card; link?: boolean;
+}) {
+  const d = dates(site);
+  return (
+    <section className="otan-hero">
+      <div className="otan-hero__diag" />
+      <div className="otan-container">
+        <nav className="otan-breadcrumb">
+          {crumbs.map((c, i) => (
+            <span key={i} className="otan-crumb">
+              {i > 0 && <span className="sep">&rsaquo;</span>}
+              {c.href ? <Link href={c.href}>{c.label}</Link> : <span className="current">{c.label}</span>}
+            </span>
+          ))}
+        </nav>
+        <h1 className="otan-title">{card && link ? <Link href={href(card)}>{title}</Link> : title}</h1>
+        {subtitle && <h3 className="otan-subtitle">{subtitle}</h3>}
+        {card && (
+          <div className="otan-meta">
+            <div>
+              {card.publishedAt && <div className="otan-date">{d.long(card.publishedAt)}</div>}
+              <div className="otan-read">
+                <svg className="ic" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><polyline points="12 7 12 12 15.5 14" /></svg>
+                {card.readingMinutes} MIN DE LECTURE
+              </div>
+            </div>
+            <div className="otan-lang2" aria-hidden="true">Français <Caret /></div>
+          </div>
+        )}
+        <hr className="otan-rule" />
+      </div>
+    </section>
+  );
+}
+
+function Share() {
+  return (
+    <aside className="otan-share" aria-label="Partager">
+      <span title="X" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M18.9 2H22l-7 8 8.2 12h-6.4l-5-7.3L6 22H3l7.5-8.6L2 2h6.5l4.5 6.6L18.9 2zm-1.1 18h1.7L7.3 4H5.5l12.3 16z" /></svg></span>
+      <span title="Facebook" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M14 9V7c0-1 .2-1.5 1.6-1.5H17V2.2C16.6 2.1 15.5 2 14.3 2 11.7 2 10 3.5 10 6.3V9H7.5v3.4H10V22h3.6v-9.6h2.7l.4-3.4H14z" /></svg></span>
+      <span title="LinkedIn" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M4.98 3.5A2.5 2.5 0 102.5 6 2.5 2.5 0 004.98 3.5zM3 8.5h4V22H3zM9 8.5h3.8v1.85h.05A4.2 4.2 0 0117 8.2c4 0 4.7 2.6 4.7 6V22h-4v-6c0-1.4 0-3.3-2-3.3s-2.3 1.5-2.3 3.2V22H9z" /></svg></span>
+      <CopyLink className="otan-share-copy" label="🔗" done="✓" />
+    </aside>
+  );
+}
+
+function Index({ site, cards }: { site: SiteConfig; cards: Card[] }) {
+  const d = dates(site);
+  return (
+    <div className="otan-index">
+      {cards.map((c) => (
+        <Link key={c.id} className="otan-item" href={href(c)}>
+          <span className="otan-item-img"><Img media={c.media} /></span>
+          <span className="otan-item-body">
+            <span className="otan-item-meta">{c.category?.name ?? "Texte officiel"}{c.publishedAt ? ` · ${d.long(c.publishedAt)}` : ""}</span>
+            <span className="otan-item-title">{c.title}</span>
+            {c.standfirst && <span className="otan-item-deck">{c.standfirst}</span>}
+          </span>
+        </Link>
+      ))}
+    </div>
+  );
+}
+
+function Home({ site, lead, cards }: HomeProps) {
+  const all = lead ? [lead, ...cards] : cards;
+  return (
+    <>
+      <Hero site={site} crumbs={[{ label: "Accueil" }, { label: "Textes officiels" }]} title="Textes officiels" subtitle={site.description || undefined} />
+      <div className="otan-container otan-body-wrap">
+        <div className="otan-article">
+          {all.length === 0 ? <p>Aucun texte publié pour l’instant.</p> : <Index site={site} cards={all} />}
+        </div>
+      </div>
+    </>
+  );
+}
+
+function Article({ site, article, related, liveNode, reactionsNode }: ArticleProps) {
+  const crumbs: Array<{ label: string; href?: string }> = [{ label: "Accueil", href: "/" }];
+  if (article.category) crumbs.push({ label: article.category.name, href: `/rubrique/${article.category.slug}` });
+  crumbs.push({ label: article.title.length > 60 ? `${article.title.slice(0, 60)}…` : article.title });
+  return (
+    <>
+      <Hero site={site} crumbs={crumbs} title={article.title} subtitle={article.standfirst || undefined} card={article} />
+      <div className="otan-container otan-body-wrap">
+        <article className="otan-article">
+          {article.media && (
+            <figure className="otan-figure">
+              <Img media={article.media} eager />
+              {captionOf(article) && <figcaption>{captionOf(article)}</figcaption>}
+            </figure>
+          )}
+          {liveNode && <div className="otan-live">{liveNode}</div>}
+          <div className="sk-prose" dangerouslySetInnerHTML={{ __html: article.body }} />
+          {article.tags.length > 0 && (
+            <p className="otan-tags">{article.tags.map((t) => <Link key={t.slug} href={`/recherche?q=${encodeURIComponent(t.name)}`}>{t.name}</Link>)}</p>
+          )}
+          <div className="otan-reactions">{reactionsNode}</div>
+          {related.length > 0 && (
+            <>
+              <h2 className="otan-related-title">Textes associés</h2>
+              <Index site={site} cards={related.slice(0, 4)} />
+            </>
+          )}
+        </article>
+        <Share />
+      </div>
+    </>
+  );
+}
+
+function List({ site, title, subtitle, cards, emptyNote, pager, search }: ListProps) {
+  return (
+    <>
+      <Hero site={site} crumbs={[{ label: "Accueil", href: "/" }, { label: title }]} title={title} subtitle={subtitle} />
+      <div className="otan-container otan-body-wrap">
+        <div className="otan-article">
+          {search && (
+            <form className="otan-searchbox" action="/recherche" method="get" role="search">
+              <input type="search" name="q" defaultValue={search.q} placeholder="Rechercher un texte…" aria-label="Rechercher" />
+              <button type="submit">RECHERCHER</button>
+            </form>
+          )}
+          {cards.length === 0 ? <p>{emptyNote}</p> : <Index site={site} cards={cards} />}
+          {pager && (
+            <nav className="otan-pager" aria-label="Pagination">
+              {pager.prev ? <Link href={pager.prev}>‹ Précédent</Link> : <span />}
+              <span>{pager.label}</span>
+              {pager.next ? <Link href={pager.next}>Suivant ›</Link> : <span />}
+            </nav>
+          )}
+        </div>
+      </div>
+    </>
+  );
+}
+
+function Page({ site, title, html, updatedAt }: PageProps) {
+  const d = dates(site);
+  return (
+    <>
+      <Hero site={site} crumbs={[{ label: "Accueil", href: "/" }, { label: title }]} title={title} subtitle={`Mis à jour le ${d.long(updatedAt)}`} />
+      <div className="otan-container otan-body-wrap">
+        <article className="otan-article"><div className="sk-prose" dangerouslySetInnerHTML={{ __html: html }} /></article>
+      </div>
+    </>
+  );
+}
+
+export const otan: SkinViews = { Shell, Home, Article, List, Page };
diff --git a/src/skins/otan/otan.css b/src/skins/otan/otan.css
