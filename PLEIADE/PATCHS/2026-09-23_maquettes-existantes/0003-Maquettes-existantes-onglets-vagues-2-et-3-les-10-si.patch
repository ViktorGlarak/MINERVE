+.sk-hexagone .hex-section-title { font-family: var(--hex-cond); font-size: 18px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: var(--dark); border-bottom: 3px solid var(--red); padding-bottom: 8px; margin: 0 0 18px; }
+.sk-hexagone .hex-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 18px; }
+.sk-hexagone .hex-tile { background: var(--off-white); border-bottom: 3px solid var(--blue); }
+.sk-hexagone .hex-tile-img { display: block; aspect-ratio: 16 / 10; background: #ddd; overflow: hidden; }
+.sk-hexagone .hex-tile-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
+.sk-hexagone .hex-tile-body { padding: 10px 12px 14px; }
+.sk-hexagone .hex-tile-cat { font-family: var(--hex-cond); font-style: italic; font-weight: 700; font-size: 12px; text-transform: uppercase; color: var(--blue); margin-bottom: 4px; }
+.sk-hexagone .hex-tile-title { font-family: var(--hex-cond); font-weight: 600; font-size: 16px; line-height: 1.2; text-transform: uppercase; color: var(--dark); display: block; }
+.sk-hexagone .hex-tile-title:hover { color: var(--blue); }
+.sk-hexagone .hex-tile-date { font-size: 11px; color: var(--grey); margin-top: 6px; }
