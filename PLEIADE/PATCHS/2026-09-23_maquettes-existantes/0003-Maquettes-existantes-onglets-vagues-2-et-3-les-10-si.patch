+.sk-hexagone .hex-search input { flex: 1; border: 1px solid var(--rule); border-right: 0; padding: 10px 12px; font-size: 14px; outline: none; font-family: var(--hex-sans); }
+.sk-hexagone .hex-search input:focus { border-color: var(--blue); }
+.sk-hexagone .hex-search button { background: var(--blue); color: white; border: 0; padding: 0 18px; font-family: var(--hex-cond); font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; }
+.sk-hexagone .hex-pager { display: flex; justify-content: space-between; padding: 0 44px 30px; font-family: var(--hex-cond); text-transform: uppercase; font-size: 13px; color: var(--grey); }
