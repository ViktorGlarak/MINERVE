diff --git a/src/skins/omerta/Omerta.tsx b/src/skins/omerta/Omerta.tsx
new file mode 100644
index 0000000..a597c37
--- /dev/null
+++ b/src/skins/omerta/Omerta.tsx
@@ -0,0 +1,281 @@
+import Link from "next/link";
+import type { Card } from "@/components/site/data";
+import type { SiteConfig } from "@/lib/site";
+import { CopyLink, NavLink } from "../client";
+import { Img, Notice, captionOf, dates, href, skinRoot } from "../shared";
+import type { ArticleProps, HomeProps, ListProps, PageProps, ShellProps, SkinViews } from "../types";
+
+/**
+ * Omerta Media — media d'opinion independant.
+ *
+ * Reprise de Sites/Site Omerta/_TEMPLATE.html : en-tete noir au logo centre,
+ * boutons « Se connecter » et « Faire un don », navigation en capitales ;
+ * bandeau gris clair au titre centre (fil d'Ariane, rubriques en or, « Par :
+ * … Date : … », partage) ; image large et sa legende ; corps en Zilla Slab et
+ * colonne « Newsletter » / « Derniers articles » ; encart auteur ; article
+ * precedent / suivant ; pied noir. Le logo (base64 dans le template) est
+ * servi par l'instance (public/skins/omerta-logo.png). Les boutons de compte,
+ * de don et de newsletter sont du decor : le site public n'a pas de comptes.
+ */
+
+const LOGO = "/skins/omerta-logo.png";
+
+function Logo({ site, footer }: { site: SiteConfig; footer?: boolean }) {
+  // eslint-disable-next-line @next/next/no-img-element
+  return <img className={footer ? "om-foot-logo-img" : "om-logo"} src={site.logoUrl || LOGO} alt={site.name} />;
+}
+
+function Shell({ site, nav, pages, children }: ShellProps) {
+  const root = skinRoot(site, "omerta");
+  return (
+    <div className={root.className} style={root.style}>
+      <Notice site={site} />
+
+      <header className="om-header">
+        <div className="om-header-row">
+          <span className="om-spacer" />
+          <Link className="om-logo-wrap" href="/"><Logo site={site} /></Link>
+          <div className="om-header-btns" aria-hidden="true">
+            <span className="om-btn-connect">Se connecter</span>
+            <span className="om-btn-don">Faire un don</span>
+          </div>
+        </div>
+        <nav className="om-nav" aria-label="Rubriques">
+          <div className="om-nav-inner">
+            <NavLink href="/">Accueil</NavLink>
+            {nav.map((m) => <NavLink key={`${m.href}-${m.label}`} href={m.href}>{m.label}</NavLink>)}
+            <NavLink href="/direct">En direct</NavLink>
+            <NavLink href="/recherche">Rechercher</NavLink>
+          </div>
+        </nav>
+      </header>
+
+      <main id="contenu">{children}</main>
+
+      <footer className="om-footer">
+        <div className="om-foot-social" aria-hidden="true"><span>f</span><span>ig</span><span>X</span><span>YT</span></div>
+        <nav className="om-foot-nav" aria-label="Rubriques">
+          {nav.map((m) => <Link key={`${m.href}-${m.label}`} href={m.href}>{m.label}</Link>)}
+        </nav>
+        <div className="om-foot-logo"><Logo site={site} footer /></div>
+        {pages.length > 0 && (
+          <div className="om-foot-legal">
+            {pages.map((p, i) => <span key={p.slug}>{i > 0 && " - "}<Link href={`/page/${p.slug}`}>{p.title}</Link></span>)}
+          </div>
+        )}
+        <div className="om-foot-host">{site.footerText || site.name}</div>
+      </footer>
+    </div>
+  );
+}
+
+function Share() {
+  return (
+    <div className="om-share">
+      <span className="om-sh" aria-hidden="true">f</span>
+      <span className="om-sh" aria-hidden="true">X</span>
+      <span className="om-sh" aria-hidden="true">P</span>
+      <CopyLink className="om-sh om-sh-copy" label="🔗" done="✓" />
+    </div>
+  );
+}
+
+/** Le bandeau de titre centre, commun a la une, a l'article et aux listes. */
+function HeroTitle({ site, card, title, crumbs, link }: {
+  site: SiteConfig; card?: Card; title: string; crumbs: Array<{ label: string; href?: string }>; link?: boolean;
+}) {
+  const d = dates(site);
+  return (
+    <section className="om-hero">
+      <div className="om-hero-inner">
+        <nav className="om-breadcrumb">
+          {crumbs.map((c, i) => (
+            <span key={i}>{i > 0 && " › "}{c.href ? <Link href={c.href}>{c.label}</Link> : c.label}</span>
+          ))}
+        </nav>
+        {card && (card.category || card.urgent || card.live) && (
+          <div className="om-cats">
+            {card.urgent && <span className="om-badge">Alerte</span>}
+            {card.live && <span className="om-badge">En direct</span>}
+            {card.category && <Link href={`/rubrique/${card.category.slug}`}>{card.category.name}</Link>}
+          </div>
+        )}
+        <h1 className="om-headline">{card && link ? <Link href={href(card)}>{title}</Link> : title}</h1>
+        {card && (
+          <div className="om-meta">
+            {card.authorName && <>Par : <strong>{card.authorName}</strong> &nbsp;&nbsp; </>}
+            {card.publishedAt && <>Date : {d.long(card.publishedAt)}</>}
+          </div>
+        )}
+        {card && <Share />}
+      </div>
+    </section>
+  );
+}
+
+function HeroImg({ card, link }: { card: Card; link?: boolean }) {
+  if (!card.media) return null;
+  const media = <div className="om-hero-media"><Img media={card.media} eager /></div>;
+  return (
+    <div className="om-hero-img">
+      {link ? <Link href={href(card)} tabIndex={-1} aria-hidden="true">{media}</Link> : media}
+      {captionOf(card) && <p className="om-hero-cap">{captionOf(card)}</p>}
+    </div>
+  );
+}
+
+function Latest({ site, cards }: { site: SiteConfig; cards: Card[] }) {
+  const d = dates(site);
+  return (
+    <div className="om-side-box om-latest">
+      <h3>Derniers articles</h3>
+      {cards.length === 0 ? <p className="om-latest-ph">Aucun article pour l’instant.</p> : (
+        <ul>
+          {cards.map((c) => (
+            <li key={c.id}>
+              <Link href={href(c)}>{c.title}</Link>
+              {c.publishedAt && <span>{d.long(c.publishedAt)}</span>}
+            </li>
+          ))}
+        </ul>
+      )}
+    </div>
+  );
+}
+
+function Sidebar({ site, cards }: { site: SiteConfig; cards: Card[] }) {
+  return (
+    <aside className="om-sidebar">
+      <div className="om-side-box om-news" aria-hidden="true">
+        <h3>Inscription Newsletter</h3>
+        <label>Adresse e-mail*</label>
+        <input type="email" disabled />
+        <label>Nom &amp; Prénom</label>
+        <input type="text" disabled />
+        <label className="om-check"><input type="checkbox" disabled /> J’accepte les termes et les conditions</label>
+        <span className="om-news-btn">Je m’inscris</span>
+      </div>
+      <Latest site={site} cards={cards} />
+    </aside>
+  );
+}
+
+function Row({ site, card }: { site: SiteConfig; card: Card }) {
+  const d = dates(site);
+  return (
+    <div className="om-row">
+      <Link className="om-row-img" href={href(card)} tabIndex={-1} aria-hidden="true"><Img media={card.media} /></Link>
+      <div>
+        {card.category && <div className="om-row-cat">{card.category.name}</div>}
+        <Link className="om-row-title" href={href(card)}>{card.title}</Link>
+        {card.standfirst && <p className="om-row-deck">{card.standfirst}</p>}
+        <div className="om-row-meta">{card.authorName ? `Par ${card.authorName}` : ""}{card.authorName && card.publishedAt ? " · " : ""}{card.publishedAt ? d.long(card.publishedAt) : ""}</div>
+      </div>
+    </div>
+  );
+}
+
+function Home({ site, lead, cards }: HomeProps) {
+  if (!lead) return <HeroTitle site={site} title={site.name} crumbs={[{ label: "Accueil" }]} />;
+  return (
+    <>
+      <HeroTitle site={site} card={lead} title={lead.title} crumbs={[{ label: "Accueil" }, { label: "À la une" }]} link />
+      <HeroImg card={lead} link />
+      <div className="om-main">
+        <div className="om-article">
+          {lead.standfirst && <p className="om-chapo">{lead.standfirst}</p>}
+          <p><Link className="om-readmore" href={href(lead)}>Lire l’article</Link></p>
+          <h2>Nos derniers articles</h2>
+          <div className="om-rows">{cards.map((c) => <Row key={c.id} site={site} card={c} />)}</div>
+        </div>
+        <Sidebar site={site} cards={cards.slice(0, 5)} />
+      </div>
+    </>
+  );
+}
+
+function Article({ site, article, related, liveNode, reactionsNode, prev, next }: ArticleProps) {
+  const crumbs: Array<{ label: string; href?: string }> = [{ label: "Accueil", href: "/" }];
+  if (article.category) crumbs.push({ label: article.category.name, href: `/rubrique/${article.category.slug}` });
+  return (
+    <>
+      <HeroTitle site={site} card={article} title={article.title} crumbs={crumbs} />
+      <HeroImg card={article} />
+      <div className="om-main">
+        <article className="om-article">
+          {article.standfirst && <p className="om-chapo">{article.standfirst}</p>}
+          {liveNode && <div className="om-live">{liveNode}</div>}
+          <div className="sk-prose" dangerouslySetInnerHTML={{ __html: article.body }} />
+          {article.tags.length > 0 && (
+            <p className="om-tags">{article.tags.map((t) => <Link key={t.slug} href={`/recherche?q=${encodeURIComponent(t.name)}`}>#{t.name}</Link>)}</p>
+          )}
+        </article>
+        <Sidebar site={site} cards={related.slice(0, 5)} />
+      </div>
+
+      {article.authorName && (
+        <div className="om-author">
+          {article.authorAvatarUrl
+            // eslint-disable-next-line @next/next/no-img-element
+            ? <img className="om-author-ph" src={article.authorAvatarUrl} alt="" />
+            : <div className="om-author-ph" />}
+          <span className="om-author-name">{article.authorName}</span>
+        </div>
+      )}
+
+      {(prev || next) && (
+        <div className="om-prevnext">
+          {prev ? <Link className="om-pn" href={href(prev)}><span>Article précédent</span><div className="om-pn-title">{prev.title}</div></Link> : <div />}
+          {next ? <Link className="om-pn" href={href(next)}><span>Article suivant</span><div className="om-pn-title">{next.title}</div></Link> : <div />}
+        </div>
+      )}
+
+      <div className="om-reactions">{reactionsNode}</div>
+    </>
+  );
+}
+
+function List({ site, title, subtitle, cards, emptyNote, pager, search }: ListProps) {
+  return (
+    <>
+      <HeroTitle site={site} title={title} crumbs={[{ label: "Accueil", href: "/" }, { label: title }]} />
+      <div className="om-main">
+        <div className="om-article">
+          {subtitle && <p className="om-count">{subtitle}</p>}
+          {search && (
+            <form className="om-search" action="/recherche" method="get" role="search">
+              <input type="search" name="q" defaultValue={search.q} placeholder="Rechercher un article…" aria-label="Rechercher" />
+              <button type="submit">Rechercher</button>
+            </form>
+          )}
+          {cards.length === 0 ? <p>{emptyNote}</p> : <div className="om-rows">{cards.map((c) => <Row key={c.id} site={site} card={c} />)}</div>}
+          {pager && (
+            <nav className="om-pager" aria-label="Pagination">
+              {pager.prev ? <Link href={pager.prev}>‹ Page précédente</Link> : <span />}
+              <span>{pager.label}</span>
+              {pager.next ? <Link href={pager.next}>Page suivante ›</Link> : <span />}
+            </nav>
+          )}
+        </div>
+        <Sidebar site={site} cards={cards.slice(0, 5)} />
+      </div>
+    </>
+  );
+}
+
+function Page({ site, title, html, updatedAt }: PageProps) {
+  const d = dates(site);
+  return (
+    <>
+      <HeroTitle site={site} title={title} crumbs={[{ label: "Accueil", href: "/" }, { label: title }]} />
+      <div className="om-main om-main-single">
+        <article className="om-article">
+          <p className="om-count">Mise à jour le {d.long(updatedAt)}</p>
+          <div className="sk-prose" dangerouslySetInnerHTML={{ __html: html }} />
+        </article>
+      </div>
+    </>
+  );
+}
+
+export const omerta: SkinViews = { Shell, Home, Article, List, Page };
