diff --git a/src/skins/zubrradio/ZubrRadio.tsx b/src/skins/zubrradio/ZubrRadio.tsx
new file mode 100644
index 0000000..477c712
--- /dev/null
+++ b/src/skins/zubrradio/ZubrRadio.tsx
@@ -0,0 +1,197 @@
+import Link from "next/link";
+import type { Card } from "@/components/site/data";
+import type { SiteConfig } from "@/lib/site";
+import { NavLink } from "../client";
+import { Img, Notice, dates, href, skinRoot } from "../shared";
+import type { ArticleProps, HomeProps, ListProps, PageProps, ShellProps, SkinViews } from "../types";
+
+/**
+ * ZubrRadio.FM — radio d'influence francophone.
+ *
+ * Reprise de Sites/Site ZubrRadio/_TEMPLATE.html : bandeau de frequence,
+ * en-tete sombre au bison et au nom ZUBR (rouge) RADIO (ambre) .FM, pastille
+ * « En direct », navigation en capitales etroites ; page d'emission : surtitre,
+ * titre, ligne « Emission … · diffusee le … · duree … · rubrique … », bandeau
+ * « transcription automatique par IA », lecteur audio (decor : l'emission n'a
+ * pas de son), puis la transcription — le corps de l'article. Les blocs
+ * .z-seg / .z-pull du template y sont reconnus s'ils arrivent d'un scenario.
+ */
+
+/** Le nom en trois couleurs : « ZUBR » rouge, le reste ambre, l'extension en clair. */
+function Nom({ name }: { name: string }) {
+  const m = name.match(/^(.*?)(\.[a-z]{2,4})?$/i);
+  const base = (m?.[1] || name).toUpperCase();
+  const ext = m?.[2]?.toUpperCase() ?? "";
+  const coupe = Math.min(4, Math.ceil(base.length / 2));
+  return <span className="z-name"><b>{base.slice(0, coupe)}</b>{base.slice(coupe)}{ext && <span className="fm"> {ext}</span>}</span>;
+}
+
+function Shell({ site, nav, pages, children }: ShellProps) {
+  const root = skinRoot(site, "zubrradio");
+  return (
+    <div className={root.className} style={root.style}>
+      <Notice site={site} />
+      <div className="z-top"><div className="z-top-in"><span>{site.name} — {site.description}</span><span>{site.baseline}</span></div></div>
+      <header className="z-header">
+        <div className="z-hd-in">
+          <Link className="z-logo" href="/">
+            {site.logoUrl
+              // eslint-disable-next-line @next/next/no-img-element
+              ? <img className="z-mark z-mark-img" src={site.logoUrl} alt="" />
+              : <span className="z-mark" aria-hidden="true">🦬</span>}
+            <span><Nom name={site.name} /><span className="z-tag">{site.baseline}</span></span>
+          </Link>
+          <Link className="z-live" href="/direct"><span className="d" />EN DIRECT</Link>
+        </div>
+      </header>
+      <nav className="z-nav" aria-label="Rubriques"><div className="z-nav-in">
+        <NavLink href="/" activeClass="on">Accueil</NavLink>
+        <NavLink href="/direct" activeClass="on">Direct</NavLink>
+        {nav.map((m) => <NavLink key={`${m.href}-${m.label}`} href={m.href} activeClass="on">{m.label}</NavLink>)}
+        <NavLink href="/recherche" activeClass="on">Transcriptions</NavLink>
+      </div></nav>
+
+      <main id="contenu">{children}</main>
+
+      <footer className="z-foot">
+        <div className="z-flogo">🦬 {site.name.toUpperCase()}</div>
+        {site.description}<br />
+        Transcriptions générées par IA
+        {pages.map((p) => <span key={p.slug}> · <Link href={`/page/${p.slug}`}>{p.title}</Link></span>)}<br />
+        <span className="z-foot-note">{site.footerText}</span>
+      </footer>
+    </div>
+  );
+}
+
+/** Une onde fixe, dessinee une fois : le lecteur est un decor, il ne joue rien. */
+const ONDE = [40, 70, 55, 90, 35, 65, 80, 50, 95, 45, 75, 30, 60, 85, 50, 70, 40, 88, 55, 72, 38, 62, 80, 48, 90, 42, 68, 33, 58, 78];
+
+function Player({ title, timecode }: { title: string; timecode?: string }) {
+  return (
+    <div className="z-player" aria-hidden="true">
+      <div className="z-play" />
+      <div className="z-pl-body">
+        <div className="z-pl-title">▶ {title}</div>
+        <div className="z-wave">{ONDE.map((h, i) => <span key={i} style={{ height: `${h}%` }} />)}</div>
+      </div>
+      <div className="z-pl-time">0:00 / {timecode || "—"}</div>
+    </div>
+  );
+}
+
+function Row({ site, card }: { site: SiteConfig; card: Card }) {
+  const d = dates(site);
+  return (
+    <Link className="z-row" href={href(card)}>
+      <span className="z-row-img"><Img media={card.media} /></span>
+      <span className="z-row-body">
+        <span className="z-kicker">{card.category?.name ?? "Émission"}</span>
+        <span className="z-row-title">{card.title}</span>
+        {card.publishedAt && <span className="z-row-meta">Diffusée le {d.long(card.publishedAt)} à {d.time(card.publishedAt)}</span>}
+      </span>
+    </Link>
+  );
+}
+
+function Home({ site, lead, cards }: HomeProps) {
+  const d = dates(site);
+  if (!lead) return <div className="z-wrap"><p className="z-note">Aucune émission publiée pour l’instant.</p></div>;
+  return (
+    <div className="z-wrap">
+      <div className="z-kicker">{lead.category?.name ?? "À l’antenne"}</div>
+      <h1 className="z-h1"><Link href={href(lead)}>{lead.title}</Link></h1>
+      <div className="z-meta">{lead.publishedAt && <>Diffusée le {d.long(lead.publishedAt)} à {d.time(lead.publishedAt)}</>}{lead.authorName && <> · avec <b>{lead.authorName}</b></>}</div>
+      {lead.media && <Link className="z-cover" href={href(lead)} tabIndex={-1} aria-hidden="true"><Img media={lead.media} eager /></Link>}
+      {lead.standfirst && <p className="z-deck">{lead.standfirst}</p>}
+      <Link className="z-listen" href={href(lead)}>▶ Lire la transcription</Link>
+      {cards.length > 0 && (
+        <section className="z-list">
+          <h2 className="z-list-title">Dernières émissions</h2>
+          {cards.map((c) => <Row key={c.id} site={site} card={c} />)}
+        </section>
+      )}
+    </div>
+  );
+}
+
+function Article({ site, article, related, liveNode, reactionsNode }: ArticleProps) {
+  const d = dates(site);
+  const f = article.fields;
+  return (
+    <div className="z-wrap">
+      <div className="z-kicker">{article.urgent && <span className="z-badge">Alerte</span>}{article.category?.name ?? "Émission"}</div>
+      <h1 className="z-h1">{article.title}</h1>
+      <div className="z-meta">
+        {f.emission && <>Émission <b>{f.emission}</b> · </>}
+        {article.publishedAt && <>diffusée le {d.long(article.publishedAt)} à {d.time(article.publishedAt)}</>}
+        {f.duree && <> · durée {f.duree}</>}
+        {article.category && <> · rubrique <b>{article.category.name}</b></>}
+      </div>
+
+      <div className="z-ai">
+        <span className="ic" aria-hidden="true">🅰️</span>
+        <div><b>Transcription &amp; traduction automatiques par intelligence artificielle.</b> Le texte ci-dessous a été généré à partir du flux audio de l’émission. Des imprécisions de transcription sont possibles. Réécoutez l’enregistrement original pour la version de référence.</div>
+      </div>
+
+      <Player title={f.emission ? `${f.emission} — ${article.title}` : article.title} timecode={f.timecode} />
+
+      {article.media && <div className="z-cover"><Img media={article.media} eager /></div>}
+      {article.standfirst && <p className="z-deck">{article.standfirst}</p>}
+      {liveNode && <div className="z-live-feed">{liveNode}</div>}
+
+      <div className="z-transcript sk-prose" dangerouslySetInnerHTML={{ __html: article.body }} />
+
+      {article.tags.length > 0 && (
+        <p className="z-tags">{article.tags.map((t) => <Link key={t.slug} href={`/recherche?q=${encodeURIComponent(t.name)}`}>#{t.name}</Link>)}</p>
+      )}
+
+      <div className="z-reactions">{reactionsNode}</div>
+
+      {related.length > 0 && (
+        <section className="z-list">
+          <h2 className="z-list-title">À réécouter</h2>
+          {related.slice(0, 4).map((c) => <Row key={c.id} site={site} card={c} />)}
+        </section>
+      )}
+    </div>
+  );
+}
+
+function List({ site, title, subtitle, cards, emptyNote, pager, search }: ListProps) {
+  return (
+    <div className="z-wrap">
+      <div className="z-kicker">{site.name}</div>
+      <h1 className="z-h1">{title}</h1>
+      {subtitle && <div className="z-meta">{subtitle}</div>}
+      {search && (
+        <form className="z-search" action="/recherche" method="get" role="search">
+          <input type="search" name="q" defaultValue={search.q} placeholder="Rechercher dans les transcriptions…" aria-label="Rechercher" />
+          <button type="submit">Chercher</button>
+        </form>
+      )}
+      {cards.length === 0 ? <p className="z-note">{emptyNote}</p> : <section className="z-list">{cards.map((c) => <Row key={c.id} site={site} card={c} />)}</section>}
+      {pager && (
+        <nav className="z-pager" aria-label="Pagination">
+          {pager.prev ? <Link href={pager.prev}>‹ Précédent</Link> : <span />}
+          <span>{pager.label}</span>
+          {pager.next ? <Link href={pager.next}>Suivant ›</Link> : <span />}
+        </nav>
+      )}
+    </div>
+  );
+}
+
+function Page({ site, title, html, updatedAt }: PageProps) {
+  const d = dates(site);
+  return (
+    <div className="z-wrap">
+      <div className="z-kicker">{site.name}</div>
+      <h1 className="z-h1">{title}</h1>
+      <div className="z-meta">Mis à jour le {d.long(updatedAt)}</div>
+      <div className="z-transcript sk-prose" dangerouslySetInnerHTML={{ __html: html }} />
+    </div>
+  );
+}
+
+export const zubrradio: SkinViews = { Shell, Home, Article, List, Page };
diff --git a/src/skins/zubrradio/zubrradio.css b/src/skins/zubrradio/zubrradio.css
new file mode 100644
index 0000000..e3a33b4
--- /dev/null
+++ b/src/skins/zubrradio/zubrradio.css
@@ -0,0 +1,124 @@
+/*
+  ZubrRadio.FM — reprise de Sites/Site ZubrRadio/_TEMPLATE.html.
+  Confine derriere .sk-zubrradio. Ambre sur --accent, rouge sur --urgent,
+  fonds sombres sur --paper / --surface, texte sur --ink.
+  Ajouts : z-row / z-list (emissions), z-cover, z-deck, z-listen, recherche.
+*/
+
+.sk-zubrradio {
+  --zubr-bg: var(--paper);
+  --zubr-panel: var(--surface);
+  --zubr-card: color-mix(in srgb, var(--surface) 55%, transparent);
+  --zubr-amber: var(--accent);
+  --zubr-amber-lt: color-mix(in srgb, var(--accent) 70%, #fff);
+  --zubr-red: var(--urgent);
+  --zubr-text: var(--ink);
+  --zubr-mut: var(--muted);
+  --zubr-rule: var(--rule);
+  --zubr-deep: color-mix(in srgb, var(--paper) 70%, #000);
+  --z-sans: var(--f-sans), Roboto, Arial, sans-serif;
+  --z-cond: var(--f-etroit), "Roboto Condensed", "Arial Narrow", sans-serif;
+  --z-disp: var(--f-oswald), Oswald, Arial, sans-serif;
+
+  font-family: var(--z-sans);
+  background: var(--zubr-bg);
+  color: var(--zubr-text);
+  font-size: 16px;
+  line-height: normal;
+  min-height: 100vh;
+  color-scheme: dark;
+}
+.sk-zubrradio a { color: inherit; text-decoration: none; }
+
+.sk-zubrradio .z-top { background: var(--zubr-deep); border-bottom: 1px solid var(--zubr-rule); font-size: 11px; color: var(--zubr-mut); }
+.sk-zubrradio .z-top-in { max-width: 1080px; margin: 0 auto; padding: 6px 20px; display: flex; justify-content: space-between; gap: 12px; letter-spacing: .05em; }
+.sk-zubrradio .z-header { background: var(--zubr-panel); border-bottom: 3px solid var(--zubr-amber); }
+.sk-zubrradio .z-hd-in { max-width: 1080px; margin: 0 auto; padding: 16px 20px; display: flex; align-items: center; gap: 16px; }
+.sk-zubrradio .z-logo { display: flex; align-items: center; gap: 12px; }
+.sk-zubrradio .z-mark { width: 46px; height: 46px; border-radius: 50%; background: radial-gradient(circle at 35% 30%, color-mix(in srgb, var(--rule) 100%, #000), var(--zubr-bg)); border: 2px solid var(--zubr-amber); display: flex; align-items: center; justify-content: center; font-size: 24px; }
+.sk-zubrradio .z-mark-img { object-fit: cover; }
+.sk-zubrradio .z-name { font-family: var(--z-disp); font-weight: 700; font-size: 26px; letter-spacing: .04em; color: var(--zubr-amber-lt); line-height: 1; display: block; }
+.sk-zubrradio .z-name b { color: var(--zubr-red); }
+.sk-zubrradio .z-name .fm { color: var(--zubr-text); font-weight: 500; font-size: 16px; }
+.sk-zubrradio .z-tag { font-family: var(--z-cond); font-size: 11px; color: var(--zubr-mut); text-transform: uppercase; letter-spacing: .16em; margin-top: 3px; display: block; }
+.sk-zubrradio .z-live { margin-left: auto; display: flex; align-items: center; gap: 7px; background: var(--zubr-red); color: #fff; font-family: var(--z-cond); font-weight: 700; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; padding: 6px 13px; border-radius: 3px; }
+.sk-zubrradio .z-live .d { width: 7px; height: 7px; border-radius: 50%; background: #fff; animation: sk-z-bl 1.2s infinite; }
+@keyframes sk-z-bl { 0%,100% { opacity: 1; } 50% { opacity: .25; } }
+.sk-zubrradio .z-nav { background: var(--zubr-deep); }
+.sk-zubrradio .z-nav-in { max-width: 1080px; margin: 0 auto; padding: 0 20px; display: flex; flex-wrap: wrap; gap: 0 22px; }
+.sk-zubrradio .z-nav a { font-family: var(--z-cond); font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--zubr-mut); line-height: 42px; }
+.sk-zubrradio .z-nav a:hover, .sk-zubrradio .z-nav a.on { color: var(--zubr-amber-lt); }
+
+.sk-zubrradio .z-wrap { max-width: 820px; margin: 0 auto; padding: 30px 20px 60px; }
+.sk-zubrradio .z-kicker { font-family: var(--z-cond); text-transform: uppercase; letter-spacing: .12em; font-size: 13px; color: var(--zubr-amber); margin-bottom: 12px; display: flex; gap: 8px; align-items: center; }
+.sk-zubrradio .z-badge { background: var(--zubr-red); color: #fff; padding: 2px 6px; letter-spacing: .08em; }
+.sk-zubrradio .z-h1 { font-family: var(--z-disp); font-weight: 700; font-size: 38px; line-height: 1.16; color: #fff; margin: 0 0 14px; }
+.sk-zubrradio .z-h1 a:hover { color: var(--zubr-amber-lt); }
+.sk-zubrradio .z-meta { font-size: 13px; color: var(--zubr-mut); border-bottom: 1px solid var(--zubr-rule); padding-bottom: 18px; margin-bottom: 22px; }
+.sk-zubrradio .z-meta b { color: var(--zubr-text); }
+
+.sk-zubrradio .z-ai { display: flex; align-items: flex-start; gap: 12px; background: var(--zubr-card); border: 1px solid var(--zubr-rule); border-left: 3px solid var(--zubr-amber); padding: 14px 16px; border-radius: 4px; margin-bottom: 24px; font-size: 13.5px; color: var(--zubr-mut); line-height: 1.5; }
+.sk-zubrradio .z-ai .ic { font-size: 20px; line-height: 1; }
+.sk-zubrradio .z-ai b { color: var(--zubr-amber-lt); font-family: var(--z-cond); letter-spacing: .04em; }
+
+.sk-zubrradio .z-player { background: var(--zubr-deep); border: 1px solid var(--zubr-rule); border-radius: 8px; padding: 16px 18px; display: flex; align-items: center; gap: 16px; margin-bottom: 30px; }
+.sk-zubrradio .z-play { flex: 0 0 auto; width: 50px; height: 50px; border-radius: 50%; background: var(--zubr-amber); display: flex; align-items: center; justify-content: center; }
+.sk-zubrradio .z-play::after { content: ''; border-left: 16px solid var(--zubr-bg); border-top: 10px solid transparent; border-bottom: 10px solid transparent; margin-left: 4px; }
+.sk-zubrradio .z-pl-body { flex: 1; min-width: 0; }
+.sk-zubrradio .z-pl-title { font-family: var(--z-cond); font-weight: 700; font-size: 14px; color: var(--zubr-text); margin-bottom: 8px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.sk-zubrradio .z-wave { height: 34px; display: flex; align-items: flex-end; gap: 2px; overflow: hidden; }
+.sk-zubrradio .z-wave span { flex: 1; background: linear-gradient(var(--zubr-amber), color-mix(in srgb, var(--accent) 40%, #000)); border-radius: 1px; opacity: .7; }
+.sk-zubrradio .z-pl-time { flex: 0 0 auto; font-family: var(--z-cond); font-size: 13px; color: var(--zubr-mut); }
+
+/* La transcription : paragraphes libres de l'editeur, ou segments du template. */
+.sk-zubrradio .z-transcript p { font-size: 17px; line-height: 1.66; color: var(--zubr-text); margin: 0 0 18px; }
+.sk-zubrradio .z-transcript h2, .sk-zubrradio .z-transcript h3 { font-family: var(--z-cond); font-weight: 700; font-size: 14px; letter-spacing: .05em; color: var(--zubr-amber-lt); text-transform: uppercase; margin: 26px 0 6px; }
+.sk-zubrradio .z-transcript strong { color: var(--zubr-amber-lt); font-family: var(--z-cond); letter-spacing: .04em; }
+.sk-zubrradio .z-transcript blockquote, .sk-zubrradio .z-pull { font-family: var(--z-disp); font-weight: 600; font-size: 24px; line-height: 1.3; color: var(--zubr-amber-lt); border-left: 3px solid var(--zubr-red); padding: 8px 0 8px 20px; margin: 28px 0; }
+.sk-zubrradio .z-transcript blockquote p { font-size: inherit; color: inherit; margin: 0; }
+.sk-zubrradio .z-transcript ul, .sk-zubrradio .z-transcript ol { margin: 0 0 18px 22px; line-height: 1.6; }
+.sk-zubrradio .z-transcript ul { list-style: disc; }
+.sk-zubrradio .z-transcript ol { list-style: decimal; }
+.sk-zubrradio .z-transcript a { color: var(--zubr-amber); text-decoration: underline; }
+.sk-zubrradio .z-seg { display: flex; gap: 16px; margin-bottom: 22px; }
+.sk-zubrradio .z-tc { flex: 0 0 56px; font-family: var(--z-cond); font-size: 13px; color: var(--zubr-amber); padding-top: 3px; }
+.sk-zubrradio .z-spk { font-family: var(--z-cond); font-weight: 700; font-size: 13px; letter-spacing: .05em; color: var(--zubr-amber-lt); text-transform: uppercase; margin-bottom: 5px; }
+.sk-zubrradio .z-txt { font-size: 17px; line-height: 1.66; color: var(--zubr-text); }
+.sk-zubrradio .z-txt q { font-style: italic; color: #fff; }
+
+.sk-zubrradio .z-foot { background: var(--zubr-deep); border-top: 1px solid var(--zubr-rule); padding: 28px 20px; text-align: center; color: var(--zubr-mut); font-size: 12px; line-height: 1.6; }
+.sk-zubrradio .z-foot .z-flogo { font-family: var(--z-disp); font-weight: 700; font-size: 18px; color: var(--zubr-amber-lt); margin-bottom: 8px; }
+.sk-zubrradio .z-foot a { color: var(--zubr-amber); }
+.sk-zubrradio .z-foot-note { opacity: .5; }
+
+/* ---- Ajouts ------------------------------------------------------------ */
+
+.sk-zubrradio .z-cover { display: block; margin: 0 0 22px; border: 1px solid var(--zubr-rule); border-radius: 6px; overflow: hidden; }
+.sk-zubrradio .z-cover img { width: 100%; height: auto; max-height: 420px; object-fit: cover; display: block; }
+.sk-zubrradio .z-deck { font-size: 18px; line-height: 1.6; color: var(--zubr-text); margin: 0 0 20px; border-left: 3px solid var(--zubr-amber); padding-left: 16px; }
+.sk-zubrradio .z-listen { display: inline-block; background: var(--zubr-amber); color: var(--accent-ink); font-family: var(--z-cond); font-weight: 700; letter-spacing: .08em; text-transform: uppercase; font-size: 13px; padding: 10px 18px; border-radius: 3px; }
+.sk-zubrradio .z-list { margin-top: 36px; }
+.sk-zubrradio .z-list-title { font-family: var(--z-cond); font-size: 14px; letter-spacing: .12em; text-transform: uppercase; color: var(--zubr-amber); border-bottom: 1px solid var(--zubr-rule); padding-bottom: 8px; margin: 0 0 6px; }
+.sk-zubrradio .z-row { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 16px; padding: 14px 0; border-bottom: 1px solid var(--zubr-rule); }
