--- /dev/null
+++ b/src/skins/onu/Onu.tsx
@@ -0,0 +1,170 @@
+import Link from "next/link";
+import type { Card } from "@/components/site/data";
+import type { SiteConfig } from "@/lib/site";
+import { NavLink } from "../client";
+import { Notice, dates, href, skinRoot } from "../shared";
+import type { ArticleProps, HomeProps, ListProps, PageProps, ShellProps, SkinViews } from "../types";
+
+/**
+ * Nations Unies — declaration officielle.
+ *
+ * Reprise de Sites/Site ONU/_TEMPLATE.html : une feuille unique posee sur un
+ * fond gris, filet bleu ONU en tete, emblème et en-tete de l'organisation,
+ * ligne de reference (« For immediate release »), surtitre, titre, corps
+ * justifie, signature (paraphe, nom, fonction), pied d'adresse. Le template
+ * n'a pas de navigation : une ligne discrete au-dessus de la feuille permet de
+ * passer d'un communique a l'autre. Libelles fixes en anglais, comme l'original.
+ */
+
+function Emblem({ site }: { site: SiteConfig }) {
+  if (site.logoUrl) {
+    // eslint-disable-next-line @next/next/no-img-element
+    return <img className="un-emblem un-emblem-img" src={site.logoUrl} alt={site.name} />;
+  }
+  return <div className="un-emblem" aria-hidden="true">UN</div>;
+}
+
+function Shell({ site, nav, pages, children }: ShellProps) {
+  const root = skinRoot(site, "onu");
+  return (
+    <div className={root.className} style={root.style}>
+      <Notice site={site} />
+      <nav className="un-nav" aria-label="Sections">
+        <NavLink href="/">Statements</NavLink>
+        {nav.map((m) => <NavLink key={`${m.href}-${m.label}`} href={m.href}>{m.label}</NavLink>)}
+        {pages.map((p) => <NavLink key={p.slug} href={`/page/${p.slug}`}>{p.title}</NavLink>)}
+        <NavLink href="/recherche">Search</NavLink>
+      </nav>
+      <main id="contenu" className="un-main">{children}</main>
+    </div>
+  );
+}
+
+/** L'en-tete de la feuille. `office` est la ligne en serif sous l'organisation. */
+function Letterhead({ site, office }: { site: SiteConfig; office: string }) {
+  return (
+    <div className="letterhead">
+      <Emblem site={site} />
+      <div className="lh-text">
+        <div className="org">{site.name}</div>
+        {site.baseline && <div className="sub">{site.baseline}</div>}
+        <div className="office">{office}</div>
+      </div>
+    </div>
+  );
+}
+
+function Footer({ site }: { site: SiteConfig }) {
+  return <div className="footer">{site.footerText || site.name}</div>;
+}
+
+function Doc({ site, office, children }: { site: SiteConfig; office: string; children: React.ReactNode }) {
+  return (
+    <div className="doc">
+      <Letterhead site={site} office={office} />
+      {children}
+      <Footer site={site} />
+    </div>
+  );
+}
+
+function Index({ site, cards }: { site: SiteConfig; cards: Card[] }) {
+  const d = dates(site);
+  return (
+    <ul className="un-index">
+      {cards.map((c) => (
+        <li key={c.id}>
+          <div className="un-index-meta">
+            {c.publishedAt && <span>{d.long(c.publishedAt)}</span>}
+            {c.category && <span>{c.category.name}</span>}
+          </div>
+          <Link className="un-index-title" href={href(c)}>{c.title}</Link>
+          {c.standfirst && <p>{c.standfirst}</p>}
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+function Home({ site, lead, cards }: HomeProps) {
+  const all = lead ? [lead, ...cards] : cards;
+  return (
+    <Doc site={site} office={site.description || "Statements"}>
+      <div className="body">
+        <div className="doc-kicker">Latest statements</div>
+        {all.length === 0 ? <p>No statement has been issued yet.</p> : <Index site={site} cards={all} />}
+      </div>
+    </Doc>
+  );
+}
+
+function Article({ site, article, liveNode, reactionsNode }: ArticleProps) {
+  const d = dates(site);
+  const f = article.fields;
+  const signataire = f.signataire || article.authorName;
+  return (
+    <>
+      <Doc site={site} office={site.description || "Statement"}>
+        <div className="ref-row">
+          <span>{f.ref || " "}</span>
+          <span>For immediate release</span>
+          <span>{article.publishedAt ? d.long(article.publishedAt) : ""}</span>
+        </div>
+        <div className="body">
+          <div className="doc-kicker">
+            {article.urgent && <span className="un-badge">Urgent</span>}
+            {article.category?.name ?? "Statement"}
+          </div>
+          <h1 className="doc-title">{article.title}</h1>
+          {article.standfirst && <p className="un-lead">{article.standfirst}</p>}
+          {liveNode && <div className="un-live">{liveNode}</div>}
+          <div className="sk-prose un-body" dangerouslySetInnerHTML={{ __html: article.body }} />
+          {signataire && (
+            <div className="sig">
+              <div className="signature-mark">{f.signature || signataire}</div>
+              <div className="name">{signataire}</div>
+              {f.fonction && <div className="title">{f.fonction}</div>}
+            </div>
+          )}
+        </div>
+      </Doc>
+      <div className="un-reactions">{reactionsNode}</div>
+    </>
+  );
+}
+
+function List({ site, title, subtitle, cards, emptyNote, pager, search }: ListProps) {
+  return (
+    <Doc site={site} office={title}>
+      <div className="body">
+        {subtitle && <div className="doc-kicker">{subtitle}</div>}
+        {search && (
+          <form className="un-search" action="/recherche" method="get" role="search">
+            <input type="search" name="q" defaultValue={search.q} placeholder="Search statements…" aria-label="Search" />
+            <button type="submit">Search</button>
+          </form>
+        )}
+        {cards.length === 0 ? <p>{emptyNote}</p> : <Index site={site} cards={cards} />}
+        {pager && (
+          <nav className="un-pager" aria-label="Pagination">
+            {pager.prev ? <Link href={pager.prev}>‹ Previous</Link> : <span />}
+            <span>{pager.label}</span>
+            {pager.next ? <Link href={pager.next}>Next ›</Link> : <span />}
+          </nav>
+        )}
+      </div>
+    </Doc>
+  );
+}
+
+function Page({ site, title, html, updatedAt }: PageProps) {
+  const d = dates(site);
+  return (
+    <Doc site={site} office={title}>
+      <div className="ref-row"><span>&nbsp;</span><span>Updated</span><span>{d.long(updatedAt)}</span></div>
+      <div className="body"><div className="sk-prose un-body" dangerouslySetInnerHTML={{ __html: html }} /></div>
+    </Doc>
+  );
+}
+
+export const onu: SkinViews = { Shell, Home, Article, List, Page };
diff --git a/src/skins/onu/onu.css b/src/skins/onu/onu.css
