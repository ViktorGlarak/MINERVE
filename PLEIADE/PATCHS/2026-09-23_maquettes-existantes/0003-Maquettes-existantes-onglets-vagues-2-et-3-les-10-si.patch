diff --git a/src/skins/efs/Efs.tsx b/src/skins/efs/Efs.tsx
new file mode 100644
index 0000000..2dcfff2
--- /dev/null
+++ b/src/skins/efs/Efs.tsx
@@ -0,0 +1,197 @@
+import Link from "next/link";
+import type { Card } from "@/components/site/data";
+import type { SiteConfig } from "@/lib/site";
+import { CopyLink, NavLink } from "../client";
+import { Img, Notice, dates, href, skinRoot } from "../shared";
+import type { ArticleProps, HomeProps, ListProps, PageProps, ShellProps, SkinViews } from "../types";
+
+/**
+ * EFS — site de campagne institutionnel (don de sang).
+ *
+ * Reprise de Sites/Site EFS/_TEMPLATE.html : barre utilitaire, en-tete blanc
+ * colle en haut au logo rond, menu bleu ciel et bouton rouge « Prendre
+ * rendez-vous » ; page d'actualite : fil d'Ariane, grand titre marine, date et
+ * temps de lecture, partage, visuel bleu arrondi au « ! » rouge (ou la photo
+ * de l'article), chapeau, corps (listes a puces rouges, encadres, citations),
+ * bouton d'appel a l'action ; pied « Une question ? Un besoin ? ».
+ */
+
+function Logo({ site, big }: { site: SiteConfig; big?: boolean }) {
+  if (site.logoUrl) {
+    // eslint-disable-next-line @next/next/no-img-element
+    return <img className={big ? "logo logo-big logo-img" : "logo logo-img"} src={site.logoUrl} alt={site.name} />;
+  }
+  return <div className={big ? "logo logo-big" : "logo"}><b>{site.name.slice(0, 4).toUpperCase()}</b><span>{site.baseline}</span></div>;
+}
+
+/** Un lien d'appel a l'action n'ouvre qu'une page du site ou une adresse web : rien d'autre. */
+function lienSur(url: string | undefined): string | null {
+  if (!url) return null;
+  const u = url.trim();
+  return u.startsWith("/") || /^https?:\/\//.test(u) ? u : null;
+}
+
+function Shell({ site, nav, pages, children }: ShellProps) {
+  const root = skinRoot(site, "efs");
+  const premiere = pages[0];
+  return (
+    <div className={root.className} style={root.style}>
+      <Notice site={site} />
+      <div className="util"><div className="util-in">
+        {pages.map((p, i) => <span key={p.slug}>{i > 0 && <span className="util-sep">|</span>}<Link href={`/page/${p.slug}`}>{p.title}</Link></span>)}
+      </div></div>
+      <header className="hdr">
+        <div className="hdr-in">
+          <Link href="/" aria-label={site.name}><Logo site={site} /></Link>
+          <nav className="nav" aria-label="Rubriques">
+            {nav.map((m) => <NavLink key={`${m.href}-${m.label}`} href={m.href}>{m.label}</NavLink>)}
+          </nav>
+          <div className="hdr-icons">
+            <Link href="/recherche" className="icon-btn" aria-label="Rechercher">&#128269;</Link>
+            <Link href={premiere ? `/page/${premiere.slug}` : "/"} className="rdv">Prendre rendez-vous</Link>
+          </div>
+        </div>
+      </header>
+
+      <main id="contenu">{children}</main>
+
+      <footer className="ft">
+        <div className="ft-in">
+          <Logo site={site} big />
+          <div>
+            <h4>Une question ? Un besoin ?</h4>
+            {pages.map((p, i) => <span key={p.slug}>{i > 0 && <> &nbsp;|&nbsp; </>}<Link href={`/page/${p.slug}`}>{p.title}</Link></span>)}
+            {pages.length > 0 && <> &nbsp;|&nbsp; </>}<Link href="/recherche">Nos actualités</Link>
+          </div>
+        </div>
+        <div className="ft-bottom">{site.footerText}</div>
+      </footer>
+    </div>
+  );
+}
+
+/** Le visuel : la photo de l'article, sinon le bandeau bleu du template et son « ! ». */
+function Hero({ card, texte }: { card: Card; texte?: string }) {
+  if (card.media) return <div className="hero hero-photo"><Img media={card.media} eager /></div>;
+  return (
+    <div className="hero" aria-hidden="true">
+      <div className="hero-txt">{texte || card.title}</div>
+      <div className="hero-bang"><b>!</b></div>
+    </div>
+  );
+}
+
+function Card_({ site, card }: { site: SiteConfig; card: Card }) {
+  const d = dates(site);
+  return (
+    <Link className="efs-card" href={href(card)}>
+      <span className="efs-card-img">{card.media ? <Img media={card.media} /> : <span className="efs-card-bang">!</span>}</span>
+      <span className="efs-card-body">
+        {card.category && <span className="efs-card-cat">{card.category.name}</span>}
+        <span className="efs-card-title">{card.title}</span>
+        {card.publishedAt && <span className="efs-card-date">{d.long(card.publishedAt)}</span>}
+      </span>
+    </Link>
+  );
+}
+
+function Home({ site, lead, cards }: HomeProps) {
+  const d = dates(site);
+  if (!lead) return <div className="efs-wrap"><h1 className="title">{site.name}</h1><p>Aucune actualité pour l’instant.</p></div>;
+  return (
+    <div className="efs-wrap">
+      <div className="crumb">Accueil &nbsp;›&nbsp; Nos actualités</div>
+      <h1 className="title"><Link href={href(lead)}>{lead.title}</Link></h1>
+      <div className="rule" />
+      {lead.publishedAt && <div className="meta"><span>&#128197; {d.long(lead.publishedAt)}</span><span>&#9201; {lead.readingMinutes} min</span></div>}
+      <Link href={href(lead)} tabIndex={-1} aria-hidden="true" className="hero-link"><Hero card={lead} /></Link>
+      {lead.standfirst && <p className="lead">{lead.standfirst}</p>}
+      <Link href={href(lead)} className="cta">Lire l’actualité</Link>
+      {cards.length > 0 && (
+        <>
+          <h2 className="big">Nos actualités</h2>
+          <div className="efs-cards">{cards.map((c) => <Card_ key={c.id} site={site} card={c} />)}</div>
+        </>
+      )}
+    </div>
+  );
+}
+
+function Article({ site, article, related, liveNode, reactionsNode }: ArticleProps) {
+  const d = dates(site);
+  const f = article.fields;
+  const lien = lienSur(f.cta_lien);
+  return (
+    <div className="efs-wrap">
+      <div className="crumb">
+        <Link href="/">Accueil</Link> &nbsp;›&nbsp; {article.category ? <Link href={`/rubrique/${article.category.slug}`}>{article.category.name}</Link> : <Link href="/recherche">Nos actualités</Link>}
+      </div>
+      <h1 className="title">{article.title}</h1>
+      <div className="rule" />
+      <div className="meta">
+        {article.publishedAt && <span>&#128197; {d.long(article.publishedAt)}</span>}
+        <span>&#9201; {article.readingMinutes} min</span>
+        <span className="share"><i aria-hidden="true">f</i><i aria-hidden="true">X</i><i aria-hidden="true">in</i><CopyLink className="share-copy" label="🔗" done="✓" /></span>
+      </div>
+
+      <Hero card={article} texte={f.visuel} />
+
+      {article.standfirst && <p className="lead">{article.standfirst}</p>}
+      {liveNode && <div className="efs-live">{liveNode}</div>}
+      <div className="efs-body sk-prose" dangerouslySetInnerHTML={{ __html: article.body }} />
+
+      {f.cta && (lien
+        ? <Link href={lien} className="cta">{f.cta}</Link>
+        : <span className="cta">{f.cta}</span>)}
+
+      <div className="efs-reactions">{reactionsNode}</div>
+
+      {related.length > 0 && (
+        <>
+          <h2>À lire aussi</h2>
+          <div className="efs-cards">{related.slice(0, 3).map((c) => <Card_ key={c.id} site={site} card={c} />)}</div>
+        </>
+      )}
+    </div>
+  );
+}
+
+function List({ site, title, subtitle, cards, emptyNote, pager, search }: ListProps) {
+  return (
+    <div className="efs-wrap">
+      <div className="crumb"><Link href="/">Accueil</Link> &nbsp;›&nbsp; {title}</div>
+      <h1 className="title">{title}</h1>
+      <div className="rule" />
+      {subtitle && <div className="meta"><span>{subtitle}</span></div>}
+      {search && (
+        <form className="efs-search" action="/recherche" method="get" role="search">
+          <input type="search" name="q" defaultValue={search.q} placeholder="Rechercher une actualité…" aria-label="Rechercher" />
+          <button type="submit">Rechercher</button>
+        </form>
+      )}
+      {cards.length === 0 ? <p>{emptyNote}</p> : <div className="efs-cards">{cards.map((c) => <Card_ key={c.id} site={site} card={c} />)}</div>}
+      {pager && (
+        <nav className="efs-pager" aria-label="Pagination">
+          {pager.prev ? <Link href={pager.prev}>‹ Précédent</Link> : <span />}
+          <span>{pager.label}</span>
+          {pager.next ? <Link href={pager.next}>Suivant ›</Link> : <span />}
+        </nav>
+      )}
+    </div>
+  );
+}
+
+function Page({ site, title, html, updatedAt }: PageProps) {
+  const d = dates(site);
+  return (
+    <div className="efs-wrap">
+      <div className="crumb"><Link href="/">Accueil</Link> &nbsp;›&nbsp; {title}</div>
+      <h1 className="title">{title}</h1>
+      <div className="rule" />
+      <div className="meta"><span>Mis à jour le {d.long(updatedAt)}</span></div>
+      <div className="efs-body sk-prose" dangerouslySetInnerHTML={{ __html: html }} />
+    </div>
+  );
+}
+
+export const efs: SkinViews = { Shell, Home, Article, List, Page };
diff --git a/src/skins/efs/efs.css b/src/skins/efs/efs.css
