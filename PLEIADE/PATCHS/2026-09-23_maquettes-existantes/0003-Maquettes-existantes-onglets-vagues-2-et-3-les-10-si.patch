+++ b/src/skins/efs/efs.css
@@ -0,0 +1,121 @@
+/*
+  EFS — reprise de Sites/Site EFS/_TEMPLATE.html.
+  Confine derriere .sk-efs. Bleu ciel sur --accent, rouge sur --urgent,
+  marine des titres sur --accent-ink, fonds d'encadre sur --surface.
+  Ajouts : efs-card / efs-cards (actualites), hero-photo, recherche.
+*/
+
+.sk-efs {
+  --navy: var(--accent-ink);
+  --red: var(--urgent);
+  --red-dk: color-mix(in srgb, var(--urgent) 80%, #000);
+  --sky: var(--accent);
+  --sky-dk: color-mix(in srgb, var(--accent) 80%, #000);
+  --grey: var(--surface);
+  --text: var(--ink);
+  --efs-sans: var(--f-sourcesans), "Source Sans 3", Arial, sans-serif;
+
+  font-family: var(--efs-sans);
+  color: var(--text);
+  background: var(--paper);
+  font-size: 16px;
+  line-height: 1.6;
+  min-height: 100vh;
+}
+.sk-efs a { color: var(--sky-dk); text-decoration: none; }
+.sk-efs a:hover { text-decoration: underline; }
+
+.sk-efs .util { border-bottom: 1px solid var(--rule); font-size: 12px; color: var(--muted); }
+.sk-efs .util-in { max-width: 1280px; margin: 0 auto; padding: 8px 24px; display: flex; justify-content: flex-end; gap: 16px; min-height: 20px; }
+.sk-efs .util a { color: var(--muted); }
+.sk-efs .util-sep { margin-right: 16px; }
+
+.sk-efs .hdr { border-bottom: 1px solid var(--rule); position: sticky; top: 0; background: #fff; z-index: 50; }
+.sk-efs .hdr-in { max-width: 1280px; margin: 0 auto; padding: 14px 24px; display: flex; align-items: center; gap: 26px; }
+.sk-efs .logo { display: flex; flex-direction: column; align-items: center; justify-content: center; width: 58px; height: 58px; border: 1.5px solid var(--navy); border-radius: 50%; flex-shrink: 0; text-align: center; }
+.sk-efs .logo-big { width: 80px; height: 80px; }
+.sk-efs .logo-img { border: 0; object-fit: contain; }
+.sk-efs .logo b { color: var(--navy); font-weight: 900; font-size: 15px; letter-spacing: .04em; line-height: 1; }
+.sk-efs .logo span { color: var(--red); font-size: 5px; font-style: italic; margin-top: 2px; line-height: 1.1; max-width: 46px; }
+.sk-efs .logo-big span { font-size: 7px; max-width: 62px; }
+.sk-efs .nav { display: flex; gap: 30px; flex: 1; flex-wrap: wrap; }
+.sk-efs .nav a { color: var(--sky-dk); font-weight: 700; font-size: 15px; }
+.sk-efs .nav a.active { color: var(--navy); }
+.sk-efs .hdr-icons { display: flex; align-items: center; gap: 14px; }
+.sk-efs .icon-btn { width: 40px; height: 40px; border: 1px solid var(--rule); border-radius: 50%; display: flex; align-items: center; justify-content: center; color: var(--red); font-size: 16px; }
+.sk-efs .icon-btn:hover { text-decoration: none; }
+.sk-efs .rdv { background: var(--red); color: #fff !important; font-weight: 900; font-size: 14px; letter-spacing: .03em; padding: 14px 26px; border-radius: 30px; text-transform: uppercase; white-space: nowrap; }
+.sk-efs .rdv:hover { background: var(--red-dk); text-decoration: none; }
+
+.sk-efs .efs-wrap { max-width: 900px; margin: 0 auto; padding: 0 24px 40px; }
+.sk-efs .crumb { padding: 34px 0 0; font-size: 14px; color: var(--muted); }
+.sk-efs .crumb a { color: var(--muted); }
+.sk-efs h1.title { font-size: 38px; font-weight: 900; color: var(--navy); line-height: 1.18; margin: 18px 0 8px; }
+.sk-efs h1.title a { color: inherit; }
+.sk-efs .rule { height: 1px; background: var(--rule); margin: 18px 0; }
+.sk-efs .meta { display: flex; align-items: center; gap: 40px; font-size: 15px; color: var(--muted); margin-bottom: 8px; flex-wrap: wrap; }
+.sk-efs .share { display: flex; gap: 6px; background: color-mix(in srgb, var(--accent) 10%, #fff); border-radius: 8px; padding: 8px 12px; }
+.sk-efs .share i, .sk-efs .share-copy { width: 30px; height: 30px; border-radius: 6px; display: flex; align-items: center; justify-content: center; color: var(--sky-dk); font-weight: 900; font-style: normal; border: 0; background: none; cursor: pointer; font-size: 14px; }
+
+.sk-efs .hero { position: relative; background: var(--sky); border-radius: 22px; height: 360px; margin: 26px 0 30px; overflow: hidden; display: flex; align-items: center; }
+.sk-efs .hero-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
+.sk-efs .hero-link { display: block; }
+.sk-efs .hero-link:hover { text-decoration: none; }
+.sk-efs .hero-txt { color: #fff; font-weight: 900; font-size: 64px; line-height: .95; letter-spacing: -.01em; padding-left: 48px; padding-right: 300px; text-transform: uppercase; }
+.sk-efs .hero-bang { position: absolute; right: -40px; top: 50%; transform: translateY(-50%); width: 330px; height: 330px; background: var(--red); border-radius: 50%; display: flex; align-items: center; justify-content: center; }
+.sk-efs .hero-bang b { color: #fff; font-weight: 900; font-size: 170px; line-height: 1; transform: translateX(-30px); }
+
+.sk-efs .lead { font-size: 18px; margin: 0 0 16px; }
+.sk-efs .efs-wrap > h2, .sk-efs .efs-body h2 { font-size: 24px; font-weight: 900; color: var(--navy); margin: 34px 0 14px; }
+.sk-efs .efs-wrap > h2.big, .sk-efs .efs-body h2.big { font-size: 34px; }
+.sk-efs .efs-body h3 { font-size: 19px; font-weight: 900; color: var(--navy); margin: 24px 0 10px; }
+.sk-efs .efs-body p { margin: 0 0 16px; }
+.sk-efs .efs-body ul { list-style: none; margin: 0 0 16px; padding: 0; }
+.sk-efs .efs-body ul li { position: relative; padding: 14px 0 14px 26px; border-bottom: 1px solid var(--rule); }
+.sk-efs .efs-body ul li::before { content: ""; position: absolute; left: 0; top: 22px; width: 10px; height: 10px; border-radius: 50%; background: var(--red); }
+.sk-efs .efs-body ul strong { color: var(--navy); }
+.sk-efs .efs-body ol { margin: 0 0 16px 22px; list-style: decimal; }
+.sk-efs .efs-body img { max-width: 100%; height: auto; }
+.sk-efs .cap { font-size: 14px; color: var(--muted); margin-bottom: 24px; }
+.sk-efs .band { background: var(--grey); border-radius: 14px; padding: 26px 30px; margin: 30px 0; }
+.sk-efs .band strong { color: var(--navy); font-size: 18px; }
+.sk-efs .efs-body blockquote { background: #fff; border: 1px solid var(--rule); border-radius: 16px; padding: 30px; margin: 30px 0; font-style: italic; color: var(--text); text-align: center; }
+.sk-efs .efs-body blockquote p:last-child { margin-bottom: 0; }
+.sk-efs .who { display: block; margin-top: 16px; font-style: normal; font-weight: 700; color: var(--sky-dk); letter-spacing: .12em; }
+.sk-efs .cta { display: block; width: 100%; max-width: 420px; background: var(--red); color: #fff !important; text-align: center; font-weight: 900; text-transform: uppercase; letter-spacing: .04em; padding: 20px; border-radius: 34px; margin: 18px 0 50px; }
+.sk-efs .cta:hover { background: var(--red-dk); text-decoration: none; }
+
+.sk-efs .ft { border-top: 1px solid var(--rule); background: #fff; padding: 40px 0; }
+.sk-efs .ft-in { max-width: 1280px; margin: 0 auto; padding: 0 24px; display: flex; flex-wrap: wrap; gap: 40px; align-items: flex-start; }
+.sk-efs .ft h4 { color: var(--navy); font-size: 22px; font-weight: 900; margin: 0 0 14px; }
+.sk-efs .ft a { color: var(--sky-dk); font-weight: 700; }
+.sk-efs .ft-bottom { border-top: 1px solid var(--rule); margin-top: 24px; padding-top: 18px; text-align: center; font-size: 12px; color: var(--muted); }
+
+/* ---- Ajouts ------------------------------------------------------------ */
+
+.sk-efs .efs-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 22px; margin-bottom: 30px; }
+.sk-efs .efs-card { display: flex; flex-direction: column; border: 1px solid var(--rule); border-radius: 16px; overflow: hidden; color: var(--text); background: #fff; }
+.sk-efs .efs-card:hover { text-decoration: none; box-shadow: 0 6px 18px rgba(0,0,0,.08); }
+.sk-efs .efs-card-img { display: flex; align-items: center; justify-content: center; aspect-ratio: 16 / 10; background: var(--sky); overflow: hidden; }
+.sk-efs .efs-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
+.sk-efs .efs-card-bang { width: 64px; height: 64px; border-radius: 50%; background: var(--red); color: #fff; font-weight: 900; font-size: 40px; display: flex; align-items: center; justify-content: center; }
+.sk-efs .efs-card-body { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px 18px; }
+.sk-efs .efs-card-cat { font-size: 13px; font-weight: 700; color: var(--sky-dk); }
+.sk-efs .efs-card-title { font-size: 19px; font-weight: 900; line-height: 1.25; color: var(--navy); }
+.sk-efs .efs-card-date { font-size: 13px; color: var(--muted); }
+.sk-efs .efs-live { margin-bottom: 24px; }
+.sk-efs .efs-reactions .sk-island { margin-top: 10px; background: var(--grey); border-radius: 14px; padding: 24px 28px; }
+.sk-efs .efs-search { display: flex; margin: 10px 0 24px; }
+.sk-efs .efs-search input { flex: 1; border: 1px solid var(--rule); border-right: 0; border-radius: 30px 0 0 30px; padding: 12px 20px; font-size: 15px; font-family: var(--efs-sans); outline: none; }
+.sk-efs .efs-search button { background: var(--red); color: #fff; border: 0; border-radius: 0 30px 30px 0; padding: 0 22px; font-weight: 900; text-transform: uppercase; font-family: var(--efs-sans); cursor: pointer; }
+.sk-efs .efs-pager { display: flex; justify-content: space-between; font-weight: 700; }
+
+@media (max-width: 760px) {
+  .sk-efs .nav { display: none; }
+  .sk-efs .hero-txt { font-size: 40px; padding-right: 180px; padding-left: 24px; }
+  .sk-efs .hero-bang { width: 200px; height: 200px; }
+  .sk-efs .hero-bang b { font-size: 100px; }
+  .sk-efs h1.title { font-size: 28px; }
+  .sk-efs .efs-cards { grid-template-columns: minmax(0, 1fr); }
+  .sk-efs .rdv { padding: 10px 16px; font-size: 12px; }
+}
