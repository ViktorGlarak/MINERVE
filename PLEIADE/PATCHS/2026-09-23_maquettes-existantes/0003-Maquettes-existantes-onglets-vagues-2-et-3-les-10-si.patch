+.sk-tf1 .tf-search input { flex: 1; border: 0; border-radius: 24px 0 0 24px; padding: 11px 18px; font-size: 15px; font-family: var(--tf-sans); outline: none; color: var(--deepBlue); }
+.sk-tf1 .tf-search button { background: var(--red); color: #fff; border: 0; border-radius: 0 24px 24px 0; padding: 0 20px; font-weight: 900; font-family: var(--tf-sans); text-transform: uppercase; font-size: 13px; cursor: pointer; }
+.sk-tf1 .tf-pager { display: flex; justify-content: space-between; margin-top: 26px; font-weight: 700; color: var(--deepBlue); }
