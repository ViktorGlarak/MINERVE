+++ b/src/skins/otan/otan.css
@@ -0,0 +1,119 @@
+/*
+  OTAN — reprise de Sites/Site OTAN/OTAN_TEMPLATE.html.
+  Confine derriere .sk-otan. Bleu des liens sur --accent, bleu des titres sur
+  --accent-ink, marine du pied sur --urgent, fond diagonal sur --surface.
+  Ajouts : otan-index / otan-item (liste des textes), otan-figure, recherche.
+*/
+
+.sk-otan {
+  --navy: var(--urgent);
+  --title: var(--accent-ink);
+  --blue: var(--accent);
+  --nav: color-mix(in srgb, var(--accent-ink) 70%, #0d2a4f);
+  --hero: var(--surface);
+  font-family: -apple-system, "Segoe UI", Arial, Helvetica, sans-serif;
+  color: var(--ink);
+  background: var(--paper);
+  line-height: normal;
+  min-height: 100vh;
+}
+.sk-otan a { color: inherit; }
+.sk-otan .otan-container { max-width: 1180px; margin: 0 auto; padding: 0 28px; }
+
+.sk-otan .otan-header { background: #fff; border-bottom: 1px solid var(--rule); position: relative; z-index: 5; }
+.sk-otan .otan-header__inner { max-width: 1340px; margin: 0 auto; padding: 14px 28px; display: flex; align-items: center; gap: 34px; }
+.sk-otan .otan-logo img { height: 58px; width: auto; display: block; }
+.sk-otan .otan-nav { display: flex; gap: 26px; flex: 1; flex-wrap: wrap; }
+.sk-otan .otan-nav a { color: var(--nav); font-weight: 700; font-size: 15px; text-decoration: none; display: flex; align-items: center; gap: 6px; letter-spacing: .2px; }
+.sk-otan .otan-nav a.active { color: var(--blue); }
+.sk-otan .caret { font-size: 10px; opacity: .7; transform: translateY(1px); }
+.sk-otan .otan-header__right { display: flex; align-items: center; gap: 26px; }
+.sk-otan .otan-search { color: var(--nav); font-weight: 600; font-size: 13px; letter-spacing: .6px; display: flex; align-items: center; gap: 8px; text-transform: uppercase; text-decoration: none; }
+.sk-otan .otan-lang { color: var(--blue); font-weight: 700; font-size: 14px; display: flex; align-items: center; gap: 6px; text-transform: uppercase; letter-spacing: .6px; }
+.sk-otan .ic { width: 15px; height: 15px; display: inline-block; fill: none; stroke: currentColor; stroke-width: 2; vertical-align: middle; }
+
+.sk-otan .otan-hero { position: relative; background: #fff; overflow: hidden; }
+.sk-otan .otan-hero__diag { position: absolute; top: 0; right: 0; width: 48%; height: 100%; background: var(--hero); clip-path: polygon(34% 0,100% 0,100% 100%,0 100%); z-index: 0; }
+.sk-otan .otan-hero .otan-container { position: relative; z-index: 1; }
+.sk-otan .otan-breadcrumb { font-size: 13px; padding: 16px 0 30px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
+.sk-otan .otan-crumb { display: inline-flex; gap: 8px; align-items: center; }
+.sk-otan .otan-breadcrumb a { color: var(--blue); text-decoration: none; font-weight: 600; }
+.sk-otan .otan-breadcrumb .sep { color: #9aa3b2; }
+.sk-otan .otan-breadcrumb .current { color: #3a4252; font-weight: 700; }
+.sk-otan .otan-title { font-family: Georgia, "Times New Roman", serif; font-weight: 400; font-size: 46px; line-height: 1.08; color: var(--title); margin: 10px 0 18px; }
+.sk-otan .otan-title a { text-decoration: none; }
+.sk-otan .otan-subtitle { font-weight: 700; font-size: 18px; line-height: 1.5; color: var(--title); margin: 0 0 24px; max-width: 760px; }
+.sk-otan .otan-meta { display: flex; justify-content: space-between; align-items: flex-start; gap: 20px; }
+.sk-otan .otan-date { font-weight: 700; color: var(--title); font-size: 15px; margin-bottom: 10px; }
+.sk-otan .otan-read { display: flex; align-items: center; gap: 8px; color: var(--muted); font-size: 12px; letter-spacing: .7px; text-transform: uppercase; font-weight: 600; }
+.sk-otan .otan-lang2 { color: var(--blue); font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: .6px; display: flex; align-items: center; gap: 6px; }
+.sk-otan .otan-rule { border: none; border-top: 1px solid var(--rule); margin: 20px 0 0; }
+
+.sk-otan .otan-body-wrap { display: flex; gap: 42px; padding-top: 40px; padding-bottom: 76px; }
+.sk-otan .otan-article { flex: 1; max-width: 820px; min-width: 0; }
+.sk-otan .otan-article p { font-size: 17px; line-height: 1.72; margin: 0 0 18px; text-align: justify; }
+.sk-otan .otan-article a { color: var(--blue); }
+.sk-otan .otan-article ul, .sk-otan .otan-article ol { font-size: 17px; line-height: 1.7; padding-left: 22px; margin: 0 0 18px; }
+.sk-otan .otan-article ul { list-style: disc; }
+.sk-otan .otan-article ol { list-style: decimal; }
+.sk-otan .otan-article li { margin-bottom: 9px; }
+.sk-otan .otan-article h2, .sk-otan .otan-article .BodySubTitle { display: block; font-weight: 700; font-size: 19px; color: var(--title); margin: 30px 0 6px; }
+.sk-otan .otan-article h3, .sk-otan .otan-article .BodySubTitle2 { display: block; font-weight: 700; font-size: 15.5px; color: var(--title); margin: 22px 0 4px; }
+.sk-otan .otan-article blockquote { border-left: 3px solid var(--blue); margin: 20px 0; padding: 4px 0 4px 18px; font-style: italic; }
+
+.sk-otan .otan-share { display: flex; flex-direction: column; gap: 6px; align-self: flex-start; position: sticky; top: 18px; padding: 14px 9px; background: #fff; box-shadow: 0 0 16px rgba(0,0,0,.09); border-radius: 4px; }
+.sk-otan .otan-share > span, .sk-otan .otan-share-copy { width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; color: #3a4252; border-radius: 50%; border: 0; background: none; cursor: pointer; font-size: 14px; }
+.sk-otan .otan-share-copy:hover { background: var(--hero); }
+.sk-otan .otan-share svg { width: 16px; height: 16px; fill: currentColor; }
+
+.sk-otan .otan-news { background: var(--navy); }
+.sk-otan .otan-news__card { max-width: 1180px; margin: 0 auto; background: #fff; padding: 46px 48px; display: flex; gap: 30px; align-items: center; justify-content: space-between; flex-wrap: wrap; transform: translateY(-30px); box-shadow: 0 20px 44px rgba(0,0,0,.12); }
+.sk-otan .otan-news__t h2 { font-family: Georgia, serif; font-weight: 400; font-size: 30px; color: var(--title); margin: 0 0 8px; line-height: 1.15; }
+.sk-otan .otan-news__t p { margin: 0; color: #5a6473; font-size: 15px; }
+.sk-otan .otan-news__f { display: flex; border: 1px solid #cfd6e2; min-width: 430px; flex: 1; max-width: 560px; }
+.sk-otan .otan-news__f input { flex: 1; border: none; padding: 16px 18px; font-size: 15px; outline: none; background: #fff; }
+.sk-otan .otan-news__btn { background: var(--navy); color: #fff; padding: 0 26px; font-weight: 700; letter-spacing: .6px; font-size: 13px; display: flex; align-items: center; }
+
+.sk-otan .otan-footer { background: var(--navy); color: #fff; padding: 0 0 42px; }
+.sk-otan .otan-footer__in { max-width: 1180px; margin: 0 auto; padding: 0 28px; }
+.sk-otan .otan-footer__cols { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 30px; padding: 6px 0 48px; }
+.sk-otan .otan-footer__cols a { color: #fff; text-decoration: none; font-size: 14px; line-height: 1.5; display: block; margin-bottom: 18px; opacity: .92; }
+.sk-otan .otan-footer__cols a:hover { text-decoration: underline; }
+.sk-otan .otan-footer__bottom { display: flex; align-items: center; gap: 18px; border-top: 1px solid rgba(255,255,255,.16); padding-top: 26px; }
+.sk-otan .otan-footer__bottom img { height: 50px; width: auto; background: #fff; padding: 4px; }
+.sk-otan .otan-footer__brand { font-size: 14px; opacity: .92; flex: 1; }
+
+/* ---- Ajouts ------------------------------------------------------------ */
+
+.sk-otan .otan-index { display: flex; flex-direction: column; }
+.sk-otan .otan-item { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 22px; padding: 20px 0; border-bottom: 1px solid var(--rule); text-decoration: none; }
+.sk-otan .otan-item-img { display: block; aspect-ratio: 16 / 10; background: var(--hero); overflow: hidden; }
+.sk-otan .otan-item-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
+.sk-otan .otan-item-body { display: flex; flex-direction: column; gap: 6px; }
+.sk-otan .otan-item-meta { font-size: 12px; font-weight: 600; letter-spacing: .6px; text-transform: uppercase; color: var(--muted); }
+.sk-otan .otan-item-title { font-family: Georgia, "Times New Roman", serif; font-size: 23px; line-height: 1.2; color: var(--title); }
+.sk-otan .otan-item:hover .otan-item-title { text-decoration: underline; }
+.sk-otan .otan-item-deck { font-size: 15px; line-height: 1.55; color: var(--ink); }
+.sk-otan .otan-figure { margin: 0 0 26px; }
+.sk-otan .otan-figure img { width: 100%; height: auto; display: block; }
+.sk-otan .otan-figure figcaption { font-size: 13px; color: var(--muted); margin-top: 8px; }
+.sk-otan .otan-tags { display: flex; gap: 14px; flex-wrap: wrap; font-size: 14px; font-weight: 600; }
+.sk-otan .otan-live { margin-bottom: 26px; }
+.sk-otan .otan-related-title { font-family: Georgia, serif; font-weight: 400; font-size: 26px; color: var(--title); margin: 40px 0 4px; }
+.sk-otan .otan-reactions .sk-island { margin-top: 34px; padding-top: 20px; border-top: 1px solid var(--rule); }
+.sk-otan .otan-searchbox { display: flex; border: 1px solid #cfd6e2; margin-bottom: 18px; }
+.sk-otan .otan-searchbox input { flex: 1; border: 0; padding: 14px 16px; font-size: 15px; outline: none; }
+.sk-otan .otan-searchbox button { background: var(--navy); color: #fff; border: 0; padding: 0 22px; font-weight: 700; letter-spacing: .6px; font-size: 13px; cursor: pointer; }
+.sk-otan .otan-pager { display: flex; justify-content: space-between; margin-top: 22px; font-weight: 700; color: var(--title); }
+.sk-otan .otan-pager a { text-decoration: none; color: var(--blue); }
+
+@media (max-width: 880px) {
+  .sk-otan .otan-nav, .sk-otan .otan-header__right { display: none; }
+  .sk-otan .otan-hero__diag { display: none; }
+  .sk-otan .otan-body-wrap { flex-direction: column; }
+  .sk-otan .otan-share { flex-direction: row; position: static; align-self: flex-start; }
+  .sk-otan .otan-footer__cols { grid-template-columns: 1fr; }
+  .sk-otan .otan-news__f { min-width: 0; }
+  .sk-otan .otan-title { font-size: 34px; }
+  .sk-otan .otan-item { grid-template-columns: 110px minmax(0, 1fr); }
+}
