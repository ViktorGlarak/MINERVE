+export async function adjacentCards(article: { id: number; publishedAt: Date | null }): Promise<{ prev: Card | null; next: Card | null }> {
+  if (!article.publishedAt) return { prev: null, next: null };
+  const at = article.publishedAt;
+  const [before, after] = await Promise.all([
+    prisma.article.findMany({ where: { ...publishedWhere(), id: { not: article.id }, publishedAt: { lt: at } }, orderBy: [{ publishedAt: "desc" }, { id: "desc" }], take: 1, select: CARD_FIELDS }),
