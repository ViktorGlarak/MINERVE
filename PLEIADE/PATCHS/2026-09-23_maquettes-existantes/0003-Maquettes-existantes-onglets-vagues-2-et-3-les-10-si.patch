@@ -0,0 +1,162 @@
+/*
+  Hexagone — reprise de Sites/Site Hexagone/_TEMPLATE.html.
+  Confine derriere .sk-hexagone. Bleu de marque sur --accent, rouge sur
+  --urgent ; le noir du ruban et de la navigation, le saumon du bandeau et
+  les bleus pales en sont derives ou gardes tels quels.
+  Classes ajoutees pour la une et les listes : prefixe hex-.
+*/
+
+.sk-hexagone {
+  --blue: var(--accent);
+  --blue-dk: color-mix(in srgb, var(--accent) 60%, #000);
+  --blue-lt: color-mix(in srgb, var(--accent) 20%, #fff);
+  --red: var(--urgent);
+  --red-dk: color-mix(in srgb, var(--urgent) 75%, #000);
+  --salmon: color-mix(in srgb, var(--urgent) 7%, #fff);
+  --salmon-op: rgba(255, 210, 210, 0.93);
+  --dark: var(--ink);
+  --mid: #444444;
+  --grey: var(--muted);
+  --off-white: var(--paper);
+  --white: var(--surface);
+  --hex-cond: var(--f-oswald), Oswald, Arial, sans-serif;
+  --hex-serif: var(--f-lora), Lora, Georgia, serif;
+  --hex-sans: var(--f-sourcesans), "Source Sans 3", Arial, sans-serif;
+
+  font-family: var(--hex-sans);
+  background: var(--off-white);
+  color: var(--dark);
+  line-height: normal;
+  min-height: 100vh;
+}
+.sk-hexagone a { text-decoration: none; color: inherit; }
+
+.sk-hexagone .top-ribbon { background: #1a1a1a; color: #aaa; font-size: 11px; padding: 5px 20px; display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
+.sk-hexagone .top-ribbon a { color: #888; margin-left: 14px; }
+.sk-hexagone .top-ribbon a:hover { color: white; }
+
+.sk-hexagone .header-band { background: white; border-bottom: 3px solid var(--blue); padding: 12px 20px; }
+.sk-hexagone .header-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
+.sk-hexagone .logo-wrap { display: flex; align-items: center; gap: 14px; }
+.sk-hexagone .hex-logo { object-fit: contain; display: block; }
+.sk-hexagone .logo-name { font-family: var(--hex-cond); font-weight: 700; font-size: 30px; letter-spacing: 0.12em; color: var(--red); line-height: 1; }
+.sk-hexagone .logo-sub { font-size: 10px; color: var(--grey); letter-spacing: 0.1em; text-transform: uppercase; margin-top: 3px; }
+.sk-hexagone .header-right { display: flex; align-items: center; gap: 14px; }
+.sk-hexagone .badge-live { background: var(--red); color: white; font-family: var(--hex-cond); font-size: 13px; font-weight: 700; letter-spacing: 0.1em; padding: 6px 14px; }
+.sk-hexagone .header-search { display: flex; }
+.sk-hexagone .header-search input { border: 1px solid var(--rule); border-right: none; padding: 7px 10px; font-size: 13px; width: 190px; outline: none; font-family: var(--hex-sans); }
+.sk-hexagone .header-search button { background: var(--blue); color: white; border: none; padding: 7px 14px; cursor: pointer; font-size: 13px; }
+
+.sk-hexagone .main-nav { background: #1a1a1a; border-bottom: 3px solid var(--red); }
+.sk-hexagone .nav-inner { max-width: 1200px; margin: 0 auto; display: flex; overflow-x: auto; }
+.sk-hexagone .nav-inner a { color: white; font-family: var(--hex-cond); font-size: 13px; font-weight: 500; letter-spacing: 0.08em; text-transform: uppercase; padding: 12px 16px; display: block; transition: background 0.15s; white-space: nowrap; }
+.sk-hexagone .nav-inner a:hover, .sk-hexagone .nav-inner a.active { background: var(--blue); }
+
+.sk-hexagone .breaking-bar { background: white; border-bottom: 1px solid var(--rule); }
+.sk-hexagone .breaking-inner { max-width: 1200px; margin: 0 auto; display: flex; align-items: stretch; }
+.sk-hexagone .breaking-label { background: var(--red); color: white; font-family: var(--hex-cond); font-weight: 700; font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; padding: 8px 16px; white-space: nowrap; display: flex; align-items: center; }
+.sk-hexagone .breaking-text { padding: 8px 18px; font-size: 13px; color: var(--dark); display: flex; align-items: center; }
+.sk-hexagone .breaking-text:hover { color: var(--blue); }
+
+.sk-hexagone .page-outer { max-width: 1200px; margin: 0 auto; background: var(--white); display: block; }
+
+.sk-hexagone .hero-wrap { position: relative; width: 100%; overflow: hidden; line-height: 0; display: block; }
+.sk-hexagone .hero-wrap > img { width: 100%; height: 460px; object-fit: cover; object-position: center top; display: block; }
