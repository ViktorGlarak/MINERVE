+.sk-hexagone .speech-closing { font-family: var(--hex-cond); font-size: 15px; font-weight: 700; text-align: center; text-transform: uppercase; letter-spacing: 0.1em; color: var(--blue-dk); border-top: 3px solid var(--blue); padding-top: 14px; margin-top: 24px; }
