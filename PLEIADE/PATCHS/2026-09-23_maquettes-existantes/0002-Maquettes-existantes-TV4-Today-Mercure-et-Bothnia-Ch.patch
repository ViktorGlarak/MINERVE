+            </div>
+          </div>
+          <div className="footer-bottom">{site.footerText || `© ${now.getFullYear()} ${site.name} · All rights reserved`}</div>
+        </div>
+      </footer>
+    </div>
+  );
+}
+
+function Meta({ site, card, lieu, share }: { site: SiteConfig; card: Card; lieu?: string; share?: boolean }) {
+  const d = dates(site);
+  return (
+    <div className="article-meta">
+      <span className="meta-source">{card.authorName ? `${site.name} — ${card.authorName}` : `${site.name} — Field Dispatch`}</span>
