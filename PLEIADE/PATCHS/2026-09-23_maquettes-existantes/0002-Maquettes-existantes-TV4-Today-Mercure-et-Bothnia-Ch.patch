+/**
+ * Les sites du dossier Sites/ qui ne sont pas encore repris. Ils apparaissent
+ * dans les reglages, grises, pour que la redaction sache ce qui arrive.
+ */
+export const SKINS_A_VENIR: Array<{ label: string; vague: number }> = [
+  { label: "Hexagone", vague: 2 },
+  { label: "TF1 Info", vague: 2 },
+  { label: "Omerta Média", vague: 2 },
+  { label: "Nations Unies", vague: 3 },
+  { label: "OTAN", vague: 3 },
+  { label: "ZubrRadio.FM", vague: 3 },
+  { label: "EFS — Don de sang", vague: 3 },
+];
+
+export const SKIN_KEYS = Object.keys(SKINS) as SkinKey[];
+
+export function isSkinKey(v: unknown): v is SkinKey {
+  return typeof v === "string" && (SKIN_KEYS as string[]).includes(v);
+}
+
+/** Les themes d'origine, indexes par leur cle de preset (« skin-tv4 »…). */
+export const SKIN_THEMES: Record<string, Theme> = Object.fromEntries(
+  Object.values(SKINS).map((s) => [s.theme.preset, s.theme]),
+);
+
+/**
+ * Les champs propres a l'habillage, relus depuis la base ou un formulaire. On
+ * garde toutes les cles texte (un article peut changer d'habillage sans rien
+ * perdre), bornees en taille : ce sont des lignes de metadonnees, pas des corps.
+ */
+export function parseSkinFields(raw: unknown): Record<string, string> {
+  let o: unknown = raw;
+  if (typeof raw === "string") {
+    try { o = JSON.parse(raw); } catch { return {}; }
+  }
+  if (!o || typeof o !== "object" || Array.isArray(o)) return {};
+  const out: Record<string, string> = {};
+  for (const [k, v] of Object.entries(o as Record<string, unknown>)) {
+    if (!/^[a-z][a-z0-9_]{0,30}$/.test(k) || typeof v !== "string") continue;
+    const t = v.trim().slice(0, 300);
+    if (t) out[k] = t;
+  }
+  return out;
+}
