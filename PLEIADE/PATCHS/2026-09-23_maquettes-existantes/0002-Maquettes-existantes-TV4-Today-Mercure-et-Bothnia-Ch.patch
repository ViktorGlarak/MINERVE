+        <div className="article-body">
+          <Kicker card={lead} />
+          <h1 className="article-headline"><Link href={href(lead)}>{lead.title}</Link></h1>
+          {lead.standfirst && <p className="article-deck">{lead.standfirst}</p>}
+          <Meta site={site} card={lead} />
+          <Link className="bc1-readmore" href={href(lead)}>Read more</Link>
+        </div>
+      </article>
+      {cards.length > 0 && (
+        <section className="bc1-section">
+          <div className="widget-title">Top Stories</div>
+          <div className="bc1-rows">{cards.map((c) => <Row key={c.id} site={site} card={c} />)}</div>
+        </section>
+      )}
+    </>
+  );
+}
+
+function Article({ site, article, related, liveNode, reactionsNode }: ArticleProps) {
+  return (
+    <>
+      <article className="article-card">
+        {article.media && <div className="article-hero"><Img media={article.media} eager /></div>}
+        {article.media && captionOf(article) && <div className="hero-caption">{captionOf(article)}</div>}
+        <div className="article-body">
+          <Kicker card={article} />
+          <h1 className="article-headline">{article.title}</h1>
+          {article.standfirst && <p className="article-deck">{article.standfirst}</p>}
+          <Meta site={site} card={article} lieu={article.fields.lieu} share />
+          {liveNode && <div className="bc1-live">{liveNode}</div>}
+          <div className="article-text">
+            <div dangerouslySetInnerHTML={{ __html: article.body }} />
+            {article.tags.length > 0 && (
+              <div className="article-tags">
+                {article.tags.map((t) => <Link key={t.slug} className="tag" href={`/recherche?q=${encodeURIComponent(t.name)}`}>{t.name}</Link>)}
+              </div>
+            )}
+          </div>
+        </div>
+      </article>
+
+      {related.length > 0 && (
+        <section className="bc1-section">
+          <div className="widget-title">Related Articles</div>
+          <div className="widget-body"><Related site={site} cards={related.slice(0, 4)} /></div>
+        </section>
+      )}
+
+      <div className="bc1-reactions">{reactionsNode}</div>
+    </>
+  );
+}
+
+function List({ site, title, subtitle, cards, emptyNote, pager, search }: ListProps) {
+  return (
+    <>
+      <div className="article-card">
+        <div className="article-body bc1-list-head">
+          <div className="article-kicker">{site.name}</div>
+          <h1 className="article-headline">{title}</h1>
+          {subtitle && <div className="bc1-count">{subtitle}</div>}
+          {search && (
+            <form className="bc1-search" action="/recherche" method="get" role="search">
+              <input type="search" name="q" defaultValue={search.q} placeholder="Search articles…" aria-label="Search" />
+              <button type="submit">Search</button>
+            </form>
+          )}
+        </div>
+      </div>
+      <section className="bc1-section">
+        {cards.length === 0
+          ? <div className="bc1-note">{emptyNote}</div>
+          : <div className="bc1-rows">{cards.map((c) => <Row key={c.id} site={site} card={c} />)}</div>}
+      </section>
+      {pager && (
+        <nav className="bc1-pager" aria-label="Pagination">
+          {pager.prev ? <Link href={pager.prev}>‹ Previous</Link> : <span />}
+          <span>{pager.label}</span>
+          {pager.next ? <Link href={pager.next}>Next ›</Link> : <span />}
+        </nav>
+      )}
+    </>
+  );
+}
+
+function Page({ site, title, html, updatedAt }: PageProps) {
+  const d = dates(site);
+  return (
+    <div className="article-card">
+      <div className="article-body">
+        <div className="article-kicker">{site.name}</div>
+        <h1 className="article-headline">{title}</h1>
+        <div className="article-meta"><span>Updated {d.long(updatedAt)}</span></div>
+        <div className="article-text" dangerouslySetInnerHTML={{ __html: html }} />
+      </div>
+    </div>
+  );
