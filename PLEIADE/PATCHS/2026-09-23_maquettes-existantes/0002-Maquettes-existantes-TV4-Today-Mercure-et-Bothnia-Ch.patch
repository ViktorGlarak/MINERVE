+import type { CSSProperties, ReactNode } from "react";
+import { themeVars } from "@/lib/theme";
+import type { SiteConfig } from "@/lib/site";
+import type { Card, CardMedia } from "@/components/site/data";
+import { ExerciseNotice } from "@/components/site/ExerciseNotice";
+import { SKINS } from "./registry";
+
+/**
+ * Les pieces que tous les habillages partagent.
+ *
+ * La plus importante est l'ilot : les reactions de lecteurs, le fil en direct
+ * et la mention d'exercice existent deja, gardes par la feuille du site public
+ * (derriere .site). Plutot que de les reecrire dix fois, chaque habillage les
+ * pose dans un ilot .site qui recoit les jetons de sa charte : ils prennent ses
+ * couleurs sans qu'on touche a leur code.
+ */
+
+export function Island({ site, className, children }: { site: SiteConfig; className?: string; children: ReactNode }) {
+  return (
+    <div className={`site sk-island${className ? ` ${className}` : ""}`} data-dark="false" style={themeVars(site.theme) as unknown as CSSProperties}>
+      {children}
+    </div>
+  );
+}
+
+/** La mention d'exercice, obligatoire sur toute page du site public, habillage ou non. */
+export function Notice({ site }: { site: SiteConfig }) {
+  return (
+    <Island site={site} className="sk-notice">
+      <ExerciseNotice />
+    </Island>
+  );
+}
+
+/** L'enveloppe d'un habillage : la classe de sa charte, et ses jetons. */
+export function skinRoot(site: SiteConfig, key: string): { className: string; style: CSSProperties } {
+  return { className: `sk sk-${key}`, style: themeVars(site.theme) as unknown as CSSProperties };
+}
+
+/* ---- Dates, dans la langue de l'habillage ------------------------------ */
+
+const TZ = process.env.SITE_TIMEZONE || "Europe/Paris";
+
+export function dates(site: SiteConfig) {
+  const lang = site.skin ? SKINS[site.skin].lang : "fr";
+  const loc = lang === "fr" ? "fr-FR" : "en-GB";
+  const d = (x: Date | string | number) => (x instanceof Date ? x : new Date(x));
+  return {
+    lang,
+    /** « 27 mai 2026 » / « 27 May 2026 » */
+    long: (x: Date | string | number) => d(x).toLocaleDateString(loc, { day: "numeric", month: "long", year: "numeric", timeZone: TZ }),
+    /** « mercredi 27 mai 2026 » / « Wednesday, 27 May 2026 » */
+    full: (x: Date | string | number) => d(x).toLocaleDateString(loc, { weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: TZ }),
+    /** « 14:32 » */
+    time: (x: Date | string | number) => d(x).toLocaleTimeString(loc, { hour: "2-digit", minute: "2-digit", timeZone: TZ }),
+  };
+}
+
+/* ---- Images ---------------------------------------------------------- */
+
+/** Une photo d'article. Sans photo, rien : un cadre vide fait maquette inachevee. */
+export function Img({ media, className, eager }: { media: CardMedia | null; className?: string; eager?: boolean }) {
+  if (!media) return null;
+  return (
+    // eslint-disable-next-line @next/next/no-img-element
+    <img className={className} src={media.url} alt={media.alt} width={media.width || undefined} height={media.height || undefined}
+      loading={eager ? "eager" : "lazy"} decoding="async" />
+  );
+}
+
+export const href = (c: Pick<Card, "slug">) => `/article/${c.slug}`;
+
+/** Legende et credit, sur une ligne, comme sous toutes les photos de presse. */
+export function captionOf(c: Pick<Card, "caption" | "credit">): string {
+  return [c.caption, c.credit ? `© ${c.credit}` : ""].filter(Boolean).join(" — ");
+}
+
+/** Le texte d'un domaine a partir de la signature du site (« … · tv4international.dr »). */
+export function domainOf(baseline: string): string {
+  const m = baseline.match(/[a-z0-9-]+(\.[a-z0-9-]+)+/i);
+  return m ? m[0] : "";
+}
