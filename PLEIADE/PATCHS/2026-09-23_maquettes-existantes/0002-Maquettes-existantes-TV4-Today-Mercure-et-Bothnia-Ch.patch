+/*
+  TV4 International — reprise de Sites/Site TV4/_TEMPLATE.html.
+
+  Les regles sont celles du template, a deux changements pres :
+  - tout est confine derriere .sk-tv4, pour ne jamais deteindre sur la
+    redaction ni sur les autres habillages ;
+  - les couleurs de marque passent par les jetons du theme (--accent,
+    --paper…) : la charte d'origine est la valeur par defaut, « Retoucher »
+    la deplace. Les nuances (orange fonce, orange pale) en sont derivees.
+  Les classes ajoutees pour les pages que le template n'avait pas (une,
+  listes, pagination, recherche) sont prefixees tv4-.
+*/
+
+.sk-tv4 {
+  --orange: var(--accent);
+  --orange-dk: color-mix(in srgb, var(--accent) 82%, #000);
+  --orange-pale: color-mix(in srgb, var(--accent) 10%, #fff);
+  --blue: var(--urgent);
+  --blue-dk: color-mix(in srgb, var(--urgent) 64%, #000);
+  --blue-pale: color-mix(in srgb, var(--urgent) 11%, #fff);
+  --dark: var(--accent-ink);
+  --white: #ffffff;
+  --bg: var(--paper);
+  --nav-bg: color-mix(in srgb, var(--paper) 45%, #fff);
+  --text: var(--ink);
+  --tv4-serif: var(--f-ptserif), "PT Serif", Georgia, serif;
+  --tv4-sans: var(--f-ptsans), "PT Sans", Arial, sans-serif;
+  --tv4-cond: var(--f-oswald), Oswald, "Arial Narrow", sans-serif;
+
+  font-family: var(--tv4-sans);
+  background: var(--bg);
+  color: var(--text);
+  font-size: 16px;
+  line-height: normal;
+  min-height: 100vh;
+}
+.sk-tv4 a { color: var(--blue-dk); text-decoration: none; }
+.sk-tv4 a:hover { color: var(--orange-dk); text-decoration: underline; }
+
+.sk-tv4 .top-bar { background: var(--dark); border-bottom: 1px solid rgba(255,255,255,0.06); }
+.sk-tv4 .tb-inner { max-width: 1240px; margin: 0 auto; padding: 7px 22px; display: flex; align-items: center; gap: 24px; }
+.sk-tv4 .tb-search { display: flex; flex-shrink: 0; }
+.sk-tv4 .tb-search input { background: rgba(255,255,255,0.07); border: 1px solid rgba(255,255,255,0.14); border-right: none; color: white; padding: 5px 10px; font-size: 12px; width: 150px; outline: none; font-family: var(--tv4-sans); }
+.sk-tv4 .tb-search input::placeholder { color: rgba(255,255,255,0.32); }
+.sk-tv4 .tb-search button { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.14); color: rgba(255,255,255,0.5); padding: 5px 10px; cursor: pointer; font-size: 13px; }
+.sk-tv4 .tb-nav { flex: 1; display: flex; justify-content: center; align-items: center; gap: 28px; }
+.sk-tv4 .tb-nav a { font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.72); letter-spacing: 0.02em; }
+.sk-tv4 .tb-nav a:hover { color: var(--orange); text-decoration: none; }
+.sk-tv4 .tb-right { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
+.sk-tv4 .tb-soc { font-size: 10px; font-weight: 700; color: rgba(255,255,255,0.4); width: 22px; height: 22px; border: 1px solid rgba(255,255,255,0.12); display: flex; align-items: center; justify-content: center; border-radius: 2px; }
+.sk-tv4 .tb-lang { position: relative; margin-left: 6px; }
+.sk-tv4 .tb-lang-btn { background: none; border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.72); padding: 4px 9px; font-size: 11px; font-weight: 700; letter-spacing: 0.05em; font-family: var(--tv4-sans); display: flex; align-items: center; gap: 4px; }
+.sk-tv4 .tb-lang-btn em { font-style: normal; font-size: 9px; color: rgba(255,255,255,0.4); }
+
+.sk-tv4 .logo-band { background: white; border-bottom: 1px solid var(--rule); }
+.sk-tv4 .lb-inner { max-width: 1240px; margin: 0 auto; padding: 16px 22px; display: flex; align-items: center; }
+.sk-tv4 .tv4-logo-wrap { display: flex; align-items: center; gap: 13px; text-decoration: none; }
+.sk-tv4 .tv4-logo-wrap:hover { text-decoration: none; }
+.sk-tv4 .tv4-lft { background: var(--orange); color: var(--blue); font-family: var(--tv4-cond); font-weight: 700; font-style: italic; font-size: 36px; line-height: 1; padding: 8px 11px 8px 16px; }
+.sk-tv4 .tv4-rgt { background: white; color: var(--blue); border: 3px solid var(--orange); border-left: none; font-family: var(--tv4-cond); font-weight: 700; font-style: italic; font-size: 36px; line-height: 1; padding: 8px 14px; }
+.sk-tv4 .tv4-logo-img { max-height: 58px; width: auto; display: block; }
+.sk-tv4 .tv4-logo-img-sm { max-height: 32px; width: auto; display: block; }
+.sk-tv4 .lb-text { display: flex; flex-direction: column; gap: 2px; }
+.sk-tv4 .lb-name { font-size: 18px; font-weight: 700; color: var(--dark); font-family: var(--tv4-sans); }
+.sk-tv4 .lb-sub { font-size: 10px; color: var(--muted); letter-spacing: 0.04em; }
+.sk-tv4 .lb-date { margin-left: auto; font-size: 12px; color: var(--muted); white-space: nowrap; }
+.sk-tv4 .lb-date::first-letter { text-transform: uppercase; }
+
+.sk-tv4 .ticker-bar { background: var(--orange); display: flex; overflow: hidden; }
+.sk-tv4 .ticker-label { background: var(--dark); color: var(--orange); font-size: 9px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; padding: 7px 16px; flex-shrink: 0; display: flex; align-items: center; gap: 6px; }
+.sk-tv4 .ticker-dot { width: 5px; height: 5px; background: var(--orange); border-radius: 50%; animation: sk-tv4-blink 1s infinite; }
+.sk-tv4 .ticker-scroll { overflow: hidden; flex: 1; display: flex; align-items: center; }
+.sk-tv4 .ticker-content { white-space: nowrap; color: var(--dark); font-size: 11px; font-weight: 700; display: inline-block; padding-left: 100%; animation: sk-tv4-marquee 60s linear infinite; }
+.sk-tv4 .ticker-content a { color: var(--dark); }
+.sk-tv4 .ticker-content a:hover { color: var(--dark); text-decoration: underline; }
+.sk-tv4 .ticker-bar:hover .ticker-content { animation-play-state: paused; }
+@keyframes sk-tv4-marquee { 0% { transform: translate3d(0,0,0); } 100% { transform: translate3d(-100%,0,0); } }
+@keyframes sk-tv4-blink { 0%,100% { opacity: 1; } 50% { opacity: 0.2; } }
+.sk-tv4 .tsep { margin: 0 16px; opacity: 0.3; }
+
+.sk-tv4 .page-wrap { max-width: 1240px; margin: 0 auto; display: grid; grid-template-columns: 210px 1fr; min-height: 600px; }
+
+.sk-tv4 .left-nav { background: white; border-right: 1px solid var(--rule); padding: 22px 0 32px; }
+.sk-tv4 .left-nav ul { list-style: none; margin: 0; padding: 0; }
+.sk-tv4 .left-nav ul li a { display: block; padding: 9px 22px; font-size: 11.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text); border-left: 3px solid transparent; }
+.sk-tv4 .left-nav ul li a:hover { color: var(--orange-dk); background: var(--orange-pale); text-decoration: none; }
+.sk-tv4 .left-nav ul li a.active { color: var(--orange-dk); border-left-color: var(--orange); background: var(--orange-pale); }
+.sk-tv4 .ln-sep { border-top: 1px solid var(--rule); margin: 14px 22px; }
