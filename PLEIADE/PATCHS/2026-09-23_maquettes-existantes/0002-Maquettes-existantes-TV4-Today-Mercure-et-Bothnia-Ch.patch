@@ -0,0 +1,168 @@
+import type { Theme } from "@/lib/theme";
+
+/**
+ * Les maquettes existantes : les sites d'exercice deja produits par la cellule
+ * (MASTAURIGE, dossier Sites/ d'AURIGE 7BB), repris ici comme habillages.
+ *
+ * Une maquette generique (quotidien, magazine…) est un jeu de reglages : on la
+ * tord a volonte. Un habillage est l'inverse — c'est la charte d'un media que
+ * les joueurs ont deja vu, et il doit rester reconnaissable au premier coup
+ * d'oeil. Sa structure (bandeaux, colonnes, pied) est donc ecrite une fois,
+ * dans ses composants et sa feuille de style ; seules ses couleurs de marque
+ * passent par les jetons du theme, pour qu'on puisse la « retoucher » sans la
+ * casser (une variante de TV4 a l'accent rouge, par exemple).
+ *
+ * Ce fichier est lu par le navigateur (reglages, editeur) comme par le
+ * serveur : il ne contient que des donnees, aucun composant.
+ */
+
+export type SkinKey = "tv4" | "todaymercure" | "bc1";
+
+/** Un champ propre a l'habillage, saisi dans l'editeur d'article. */
+export interface SkinField {
+  key: string;
+  label: string;
+  hint: string;
+  placeholder?: string;
+}
+
+export interface SkinDef {
+  key: SkinKey;
+  label: string;
+  /** ce qu'est le media, en une ligne, pour la vignette des reglages */
+  hint: string;
+  /** langue de l'habillage : ses libelles fixes et ses dates */
+  lang: "fr" | "en";
+  /** identite reprise quand on adopte l'habillage (modifiable ensuite) */
+  identity: { name: string; baseline: string; description: string; footerText: string };
+  /** la charte d'origine, en jetons : c'est ce que « Retoucher » modifie */
+  theme: Theme;
+  /** champs d'article propres a l'habillage */
+  fields: SkinField[];
+  /** trois couleurs pour la vignette : bandeau, accent, fond */
+  swatch: [string, string, string];
+  /**
+   * Ce que chaque jeton de couleur peint dans cet habillage. Les libelles
+   * generiques (« Accent », « Alerte ») ne disent rien d'une charte precise ;
+   * ceux-ci s'affichent quand on retouche.
+   */
+  colorLabels: Partial<Record<keyof Theme["colors"], string>>;
+}
+
