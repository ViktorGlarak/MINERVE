+++ b/src/skins/views.ts
@@ -0,0 +1,14 @@
+import type { SiteConfig } from "@/lib/site";
+import type { SkinKey } from "./registry";
+import type { SkinViews } from "./types";
+import { bc1 } from "./bc1/Bc1";
+import { todaymercure } from "./todaymercure/TodayMercure";
+import { tv4 } from "./tv4/Tv4";
+
+/** Les composants de chaque habillage. Le registre (registry.ts) tient les donnees. */
+export const SKIN_VIEWS: Record<SkinKey, SkinViews> = { tv4, todaymercure, bc1 };
+
+/** L'habillage du site, ou null quand il garde une maquette generique. */
+export function skinOf(site: SiteConfig): SkinViews | null {
+  return site.skin ? SKIN_VIEWS[site.skin] ?? null : null;
+}
