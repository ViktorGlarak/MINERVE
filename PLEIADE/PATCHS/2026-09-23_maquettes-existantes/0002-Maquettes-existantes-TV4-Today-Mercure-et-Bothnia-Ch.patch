new file mode 100644
index 0000000..eb9864b
--- /dev/null
+++ b/src/components/redaction/reglages/ApercuSkin.tsx
@@ -0,0 +1,91 @@
+"use client";
+
+import { useEffect, useRef, useState } from "react";
+import type { Theme } from "@/lib/theme";
+import type { SiteConfig } from "@/lib/site";
+import type { Card } from "@/components/site/data";
+import { SKINS, type SkinKey } from "@/skins/registry";
+import { SKIN_VIEWS } from "@/skins/views";
+
+/**
+ * L'apercu d'une maquette existante.
+ *
+ * La fausse une generique (ApercuTheme) ne saurait pas imiter TV4 : un
+ * habillage, c'est une structure. On rend donc le vrai habillage — ses
+ * composants, sa feuille de style — a sa largeur de bureau, reduit a la
+ * taille du panneau. Ce qu'on voit ici est ce que verront les joueurs, aux
+ * articles pres (ceux-ci sont factices). Rien n'est cliquable : l'apercu ne
+ * doit pas emmener le directeur hors de ses reglages.
+ */
+
+const LARGEUR = 1240;
+const HAUTEUR = 1500;
+
+/** Une image factice aux couleurs de la charte, pour que les vignettes ne soient pas vides. */
+function faussePhoto(fond: string, trait: string, i: number) {
+  const svg = `<svg xmlns='http://www.w3.org/2000/svg' width='1200' height='675' viewBox='0 0 1200 675'>`
+    + `<rect width='1200' height='675' fill='${fond}'/>`
+    + `<circle cx='${300 + i * 170}' cy='250' r='120' fill='${trait}' opacity='.35'/>`
+    + `<rect x='0' y='470' width='1200' height='205' fill='${trait}' opacity='.18'/></svg>`;
+  return { url: `data:image/svg+xml,${encodeURIComponent(svg)}`, alt: "", credit: "", width: 1200, height: 675 };
+}
+
+function faussesCartes(lang: "fr" | "en", fond: string, trait: string): Card[] {
+  const fr = [
+    { t: "Des milliers de civils sur les routes à l’ouest de HNANCY", c: "Société", s: "Les préfectures ouvrent des centres d’accueil d’urgence alors que les combats s’intensifient." },
+    { t: "Les maires demandent des couloirs humanitaires au commandement", c: "Politique", s: "Une lettre commune signée par cinq élus." },
+    { t: "Les hôpitaux de la région signalent une saturation", c: "Santé", s: "" },
+    { t: "Engagement confirmé des forces alliées en Lorraine", c: "Défense", s: "" },
+    { t: "La Croix-Rouge appelle à la protection des civils", c: "Monde", s: "" },
+  ];
+  const en = [
+    { t: "Armed Forces secure the eastern corridor ahead of schedule", c: "Defence", s: "Field commanders report a decisive advance as allied positions fall back across the Moselle." },
+    { t: "Joint declaration signed at the Presidential Palace", c: "Politics", s: "" },
+    { t: "Humanitarian convoy reaches displaced families", c: "Society", s: "" },
+    { t: "Ministry denies western claims on casualties", c: "World", s: "" },
+    { t: "Energy prices stabilise after emergency measures", c: "Economy", s: "" },
+  ];
+  const base = Date.now();
+  return (lang === "fr" ? fr : en).map((x, i) => ({
+    id: -1 - i, slug: `apercu-${i}`, title: x.t, standfirst: x.s, publishedAt: new Date(base - i * 47 * 60_000),
+    readingMinutes: 3, urgent: i === 0, live: false, pinned: i === 0, authorName: lang === "fr" ? "Camille Ferrand" : "Anna Volkova",
+    authorAvatarUrl: null, category: { id: i, slug: `r${i}`, name: x.c, color: "" }, media: faussePhoto(fond, trait, i), caption: "", credit: "",
+  }));
+}
+
+export function ApercuSkin({ skin, theme, siteName, baseline, description }: {
+  skin: SkinKey; theme: Theme; siteName: string; baseline: string; description: string;
+}) {
+  const boite = useRef<HTMLDivElement>(null);
+  const [echelle, setEchelle] = useState(0.3);
+
+  useEffect(() => {
+    const el = boite.current;
+    if (!el) return;
+    const mesurer = () => setEchelle(el.clientWidth / LARGEUR);
+    mesurer();
+    const ro = new ResizeObserver(mesurer);
+    ro.observe(el);
+    return () => ro.disconnect();
+  }, []);
+
+  const def = SKINS[skin];
+  const Vue = SKIN_VIEWS[skin];
+  const site: SiteConfig = {
+    name: siteName, baseline, description, logoUrl: null, layout: "journal", skin, theme,
+    homepage: [], menu: null, footerText: def.identity.footerText, newsroomGroupIds: [], commentsEnabled: true, commentsModerated: false,
+  };
+  const cartes = faussesCartes(def.lang, def.swatch[0], def.swatch[1]);
+  const [lead, ...reste] = cartes;
+  const nav = cartes.map((c) => ({ label: c.category!.name, href: `/rubrique/${c.category!.slug}` }));
+
+  return (
+    <div ref={boite} style={{ height: HAUTEUR * echelle, overflow: "hidden", position: "relative", border: "1px solid var(--color-line-soft)" }} aria-hidden="true">
+      <div style={{ width: LARGEUR, height: HAUTEUR, transform: `scale(${echelle})`, transformOrigin: "top left", pointerEvents: "none", position: "absolute", top: 0, left: 0 }} inert>
+        <Vue.Shell site={site} nav={nav} pages={[{ slug: "contact", title: "Contact" }]} ticker={cartes.slice(0, 3)} live={null} liveEntries={[]} latest={cartes}>
+          <Vue.Home site={site} lead={lead} cards={reste} live={null} />
+        </Vue.Shell>
+      </div>
+    </div>
+  );
+}
