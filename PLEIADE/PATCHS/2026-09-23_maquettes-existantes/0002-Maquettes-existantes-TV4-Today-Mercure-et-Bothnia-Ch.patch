+import Link from "next/link";
+import type { Card, LiveItem } from "@/components/site/data";
+import type { SiteConfig } from "@/lib/site";
+import { CopyLink, NavLink } from "../client";
+import { Img, Notice, captionOf, dates, domainOf, href, skinRoot } from "../shared";
+import type { ArticleProps, HomeProps, ListProps, PageProps, ShellProps, SkinViews } from "../types";
+
+/**
+ * Today Mercure — agence de presse d'Etat de la Republique de Mercure.
+ *
+ * Reprise de Sites/Site Today Mercure/_TEMPLATE.html : barre noire (date,
+ * liens, VK/TG), en-tete noir au logo TODAY ★ MERCURE, navigation, bandeau
+ * « Breaking » rouge et sa sous-ligne or, grille article + colonne de 300px,
+ * pied noir. Le site d'origine est en anglais : ses libelles fixes aussi.
+ */
+
+function Logo({ site, footer }: { site: SiteConfig; footer?: boolean }) {
+  if (site.logoUrl) {
+    // eslint-disable-next-line @next/next/no-img-element
+    return <img className={footer ? "tm-logo-img-sm" : "tm-logo-img"} src={site.logoUrl} alt={site.name} />;
+  }
+  // Le logo d'origine coupe le nom en deux : « TODAY » en noir d'affiche, le
+  // reste en serif rouge. Un autre nom garde la meme construction.
+  const [first, ...rest] = site.name.trim().split(/\s+/);
+  return (
+    <>
+      <span className="logo-today">{(first || "TODAY").toUpperCase()}</span>
+      <span className="logo-star">★</span>
+      <span className="logo-mercure">{(rest.join(" ") || "MERCURE").toUpperCase()}</span>
+    </>
+  );
+}
+
+function strip(html: string): string {
+  return html.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
+}
+
+function LiveWidget({ site, live, entries, latest }: { site: SiteConfig; live: Card | null; entries: LiveItem[]; latest: Card[] }) {
+  const d = dates(site);
+  return (
+    <div className="widget">
+      <div className="widget-title">{live ? `${site.name} — Live` : "Latest dispatches"}</div>
+      <div className="widget-body">
+        {live && entries.length > 0 ? (
+          <>
+            <Link className="tm-widget-link" href={href(live)}>{live.title}</Link>
+            {entries.slice(0, 6).map((e) => (
+              <div key={e.id} className="feed-item">
+                <div className="feed-time">{d.time(e.publishedAt)}</div>
+                {e.title || strip(e.body).slice(0, 160)}
+              </div>
+            ))}
+          </>
+        ) : latest.length > 0 ? (
+          latest.slice(0, 5).map((c) => (
+            <div key={c.id} className="feed-item">
+              <div className="feed-time">{c.publishedAt ? d.time(c.publishedAt) : "—"}</div>
+              <Link href={href(c)}>{c.title}</Link>
+            </div>
+          ))
+        ) : (
+          <div className="feed-item"><div className="feed-time">&mdash;</div>No dispatch published yet.</div>
+        )}
+      </div>
+    </div>
+  );
+}
+
+export function RelatedList({ site, cards }: { site: SiteConfig; cards: Card[] }) {
+  const d = dates(site);
+  return (
+    <>
+      {cards.map((c) => (
+        <div key={c.id} className="related-item">
+          <Link className="related-thumb" href={href(c)} tabIndex={-1} aria-hidden="true"><Img media={c.media} /></Link>
+          <div>
+            {c.category && <div className="rel-cat">{c.category.name}</div>}
+            <Link className="rel-title" href={href(c)}>{c.title}</Link>
+            {c.publishedAt && <div className="rel-date">{d.long(c.publishedAt)}</div>}
+          </div>
+        </div>
+      ))}
+    </>
+  );
+}
+
+function Shell({ site, nav, pages, ticker, live, liveEntries, latest, children }: ShellProps) {
+  const root = skinRoot(site, "todaymercure");
+  const d = dates(site);
+  const now = new Date();
+  const domaine = domainOf(site.baseline) || domainOf(site.footerText);
+
+  return (
+    <div className={root.className} style={root.style}>
+      <Notice site={site} />
+
+      <div className="top-bar">
+        <div className="top-bar-inner">
+          <span className="top-bar-date">{d.full(now)} &nbsp;·&nbsp; {site.name}</span>
+          <div className="top-bar-links">
+            {nav.slice(0, 3).map((m) => <Link key={`${m.href}-${m.label}`} href={m.href}>{m.label}</Link>)}
+            <div className="top-bar-soc" aria-hidden="true">
+              <span className="soc-btn">VK</span>
+              <span className="soc-btn">TG</span>
+            </div>
+          </div>
+        </div>
+      </div>
+
+      <header className="site-header">
+        <div className="header-inner">
+          <Link href="/" className="logo-wrap"><Logo site={site} /></Link>
+          <div className="header-meta">
+            <div className="site-name-main">{site.baseline || site.name}</div>
+            {domaine && <div className="site-name-sub">{domaine} &nbsp;·&nbsp; English Edition</div>}
+          </div>
+          <div className="header-right">
+            <Link className="live-badge" href="/direct">● Live</Link>
+            <div className="header-lang" aria-hidden="true">
+              <span className="lang-btn active">EN</span>
+              <span className="lang-btn">MR</span>
+              <span className="lang-btn">RU</span>
+            </div>
+          </div>
+        </div>
+      </header>
+
+      <nav className="main-nav" aria-label="Sections">
+        <div className="nav-inner">
+          <NavLink href="/">Home</NavLink>
+          {nav.map((m) => <NavLink key={`${m.href}-${m.label}`} href={m.href}>{m.label}</NavLink>)}
+          <NavLink href="/direct">Live</NavLink>
+        </div>
+      </nav>
+
+      {ticker.length > 0 && (
+        <div className="ticker-bar">
+          <div className="ticker-label"><span className="ticker-dot" />BREAKING</div>
+          <div className="ticker-scroll">
+            <div className="ticker-content">
+              {ticker.map((t, i) => (
+                <span key={t.slug}>
+                  {i > 0 && <span className="tsep">&middot;</span>}
