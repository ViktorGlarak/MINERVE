+"use client";
+
+import Link from "next/link";
+import { usePathname } from "next/navigation";
+import { useState } from "react";
+
+/**
+ * Les deux seules pieces d'habillage qui ont besoin du navigateur : le lien de
+ * navigation qui sait s'il est la page courante, et le bouton qui copie
+ * l'adresse de l'article. Le reste des habillages est rendu cote serveur.
+ */
+
+export function NavLink({ href, className, activeClass = "active", children }: {
+  href: string; className?: string; activeClass?: string; children: React.ReactNode;
+}) {
+  const path = usePathname();
+  const actif = href === "/" ? path === "/" : path === href || path.startsWith(`${href}/`);
+  const cls = [className, actif ? activeClass : ""].filter(Boolean).join(" ");
+  return (
+    <Link href={href} className={cls || undefined} aria-current={actif ? "page" : undefined}>
+      {children}
+    </Link>
+  );
+}
+
+export function CopyLink({ className, label, done }: { className?: string; label: string; done: string }) {
+  const [ok, setOk] = useState(false);
+  return (
+    <button type="button" className={className} onClick={() => {
+      navigator.clipboard?.writeText(window.location.href).then(() => {
+        setOk(true);
+        window.setTimeout(() => setOk(false), 2000);
+      }).catch(() => setOk(false));
+    }}>
+      {ok ? done : label}
+    </button>
+  );
+}
