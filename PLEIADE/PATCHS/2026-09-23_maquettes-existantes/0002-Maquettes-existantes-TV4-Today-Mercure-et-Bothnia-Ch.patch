+ * langue), bandeau du logo, bandeau defilant orange, grille 210px + contenu
+ * avec la nav gauche et l'encart « a l'antenne », fil d'Ariane, carte
+ * d'article, « A lire egalement », pied complet. Ce qui etait ecrit en dur
+ * dans le template (rubriques, titres du bandeau, articles lies) vient
+ * maintenant de la base.
+ */
+
+function Logo({ name, logoUrl, small }: { name: string; logoUrl: string | null; small?: boolean }) {
+  if (logoUrl) {
+    // eslint-disable-next-line @next/next/no-img-element
+    return <img className={small ? "tv4-logo-img-sm" : "tv4-logo-img"} src={logoUrl} alt={name} />;
+  }
+  return small
+    ? <div className="footer-logo"><span className="ftl">TV</span><span className="ftr">4</span></div>
+    : <div><span className="tv4-lft">TV</span><span className="tv4-rgt">4</span></div>;
+}
+
+function Shell({ site, nav, pages, ticker, live, children }: ShellProps) {
+  const root = skinRoot(site, "tv4");
+  const d = dates(site);
+  const now = new Date();
+  const prochain = new Date(now.getTime() + 3600_000);
+  const domaine = domainOf(site.baseline);
+
+  return (
+    <div className={root.className} style={root.style}>
+      <Notice site={site} />
+
+      <div className="top-bar">
+        <div className="tb-inner">
+          <form className="tb-search" action="/recherche" method="get" role="search">
+            <input type="search" name="q" placeholder="Rechercher..." aria-label="Rechercher un article" />
+            <button type="submit" aria-label="Lancer la recherche">&#128269;</button>
+          </form>
+          <nav className="tb-nav" aria-label="Accès rapide">
+            <Link href="/recherche">Dernières infos</Link>
+            <Link href="/direct">En direct</Link>
+            {pages.slice(0, 2).map((p) => <Link key={p.slug} href={`/page/${p.slug}`}>{p.title}</Link>)}
+          </nav>
+          <div className="tb-right" aria-hidden="true">
+            <span className="tb-soc">X</span>
+            <span className="tb-soc">f</span>
+            <span className="tb-soc">YT</span>
+            <span className="tb-soc">TG</span>
+            <div className="tb-lang"><span className="tb-lang-btn">FR <em>&#9660;</em></span></div>
+          </div>
+        </div>
+      </div>
+
+      <div className="logo-band">
+        <div className="lb-inner">
+          <Link className="tv4-logo-wrap" href="/">
+            <Logo name={site.name} logoUrl={site.logoUrl} />
+            <div className="lb-text">
+              <span className="lb-name">{site.name}</span>
+              {site.baseline && <span className="lb-sub">{site.baseline}</span>}
+            </div>
+          </Link>
+          <span className="lb-date">{d.full(now)} &nbsp;&middot;&nbsp; CET</span>
+        </div>
+      </div>
+
+      {ticker.length > 0 && (
+        <div className="ticker-bar">
+          <div className="ticker-label"><span className="ticker-dot" />&nbsp;Alerte</div>
+          <div className="ticker-scroll">
+            <span className="ticker-content">
+              {ticker.map((t, i) => (
+                <span key={t.slug}>
+                  {i > 0 && <span className="tsep">|</span>}
+                  <Link href={`/article/${t.slug}`}>{t.title}</Link>
+                </span>
+              ))}
+            </span>
+          </div>
+        </div>
+      )}
+
+      <div className="page-wrap">
+        <nav className="left-nav" aria-label="Rubriques">
+          <ul>
+            <li><NavLink href="/">Accueil</NavLink></li>
+            {nav.map((m) => <li key={`${m.href}-${m.label}`}><NavLink href={m.href}>{m.label}</NavLink></li>)}
+          </ul>
+          <div className="ln-sep" />
+          <div className="ln-secondary">
+            <Link className="ln-live" href="/direct"><span className="live-dot" />&nbsp;Direct</Link>
+            {pages.map((p) => <Link key={p.slug} href={`/page/${p.slug}`}>{p.title}</Link>)}
+          </div>
+          {live ? (
+            <Link className="ln-onair" href={href(live)}>
+              <div className="ln-onair-title">Édition spéciale</div>
+              <div className="ln-onair-sub">{live.title}</div>
+              <div className="ln-onair-next">&#9679; Suivre le direct</div>
+            </Link>
+          ) : (
+            <div className="ln-onair">
+              <div className="ln-onair-title">À l’antenne</div>
+              <div className="ln-onair-sub">{site.description || site.name}</div>
+              <div className="ln-onair-next">&#9679; Prochain bulletin : {prochain.getHours().toString().padStart(2, "0")}h00 CET</div>
+            </div>
+          )}
+        </nav>
+
+        <div className="article-area">{children}</div>
+      </div>
+
+      <footer className="site-footer">
+        <div className="footer-inner">
+          <div className="footer-top">
+            <Logo name={site.name} logoUrl={site.logoUrl} small />
+            <span className="footer-tagline">
+              {[site.name, site.description, domaine].filter(Boolean).join("  ·  ")}
+            </span>
+            <div className="footer-social" aria-hidden="true">
+              <span className="fsoc">X</span><span className="fsoc">f</span><span className="fsoc">YT</span><span className="fsoc">TG</span>
+            </div>
+            <div className="footer-links">
+              {pages.map((p) => <Link key={p.slug} href={`/page/${p.slug}`}>{p.title}</Link>)}
+              <Link href="/recherche">Rechercher</Link>
+            </div>
+          </div>
+          <div className="footer-bottom">{site.footerText || `© ${now.getFullYear()} ${site.name}. Tous droits réservés.`}</div>
+        </div>
+      </footer>
+    </div>
+  );
+}
+
+function Breadcrumb({ items }: { items: Array<{ label: string; href?: string }> }) {
+  return (
+    <div className="breadcrumb">
+      {items.map((it, i) => (
+        <span key={i} className="bc-item">
+          {i > 0 && <span className="bc-sep">&#8250;</span>}
+          {it.href ? <Link href={it.href}>{it.label}</Link> : <span>{it.label}</span>}
+        </span>
+      ))}
+    </div>
+  );
+}
+
+function MoreCard({ card, site }: { card: Card; site: ShellProps["site"] }) {
+  const d = dates(site);
+  return (
+    <div className="more-card">
+      <Link className="more-card-img" href={href(card)} tabIndex={-1} aria-hidden="true">
+        <Img media={card.media} />
+      </Link>
+      <div className="more-card-body">
+        <div className="more-card-cat">
+          {card.live && <span className="tv4-badge">Direct</span>}
+          {card.urgent && <span className="tv4-badge">Alerte</span>}
+          {card.category?.name}
+        </div>
+        <Link href={href(card)} className="more-card-title">{card.title}</Link>
+        <div className="more-card-date">{card.publishedAt ? d.long(card.publishedAt) : ""} &nbsp;&middot;&nbsp; {site.name}</div>
+      </div>
+    </div>
+  );
+}
+
+function More({ title, cards, site }: { title: string; cards: Card[]; site: ShellProps["site"] }) {
+  if (!cards.length) return null;
+  return (
+    <div className="more-section">
+      <div className="more-header">
+        <span className="more-title">{title}</span>
+        <div className="more-rule" />
+      </div>
+      <div className="more-grid">
+        {cards.map((c) => <MoreCard key={c.id} card={c} site={site} />)}
+      </div>
+    </div>
+  );
+}
+
+function Home({ site, lead, cards, live }: HomeProps) {
+  const d = dates(site);
+  if (!lead) {
+    return (
+      <>
+        <Breadcrumb items={[{ label: "Accueil" }]} />
+        <div className="article-card tv4-empty">
+          <p className="article-kicker">{site.name}</p>
+          <p className="article-deck">Aucun article publié pour l’instant. La rédaction n’a encore rien mis en ligne.</p>
+        </div>
+      </>
+    );
+  }
+  return (
+    <>
+      <Breadcrumb items={[{ label: "Accueil" }, { label: "À la une" }]} />
+      <article className="article-card tv4-lead">
+        {lead.media && (
+          <Link className="hero-wrap has-img" href={href(lead)} tabIndex={-1} aria-hidden="true"><Img media={lead.media} eager /></Link>
+        )}
+        {lead.media && captionOf(lead) && <p className="hero-caption">{captionOf(lead)}</p>}
+        <div className="article-head">
+          <p className="article-kicker">
+            {lead.urgent && <span className="tv4-badge">Alerte</span>}
+            {lead.live && <span className="tv4-badge">Direct</span>}
+            {lead.category?.name ?? "À la une"}
+          </p>
+          <h1 className="article-headline"><Link href={href(lead)}>{lead.title}</Link></h1>
+          {lead.standfirst && <p className="article-deck">{lead.standfirst}</p>}
+          <div className="article-meta">
+            <span className="meta-source">{site.name}</span>
+            {lead.authorName && <><span className="meta-dot" /><span>{lead.authorName}</span></>}
+            {lead.publishedAt && <><span className="meta-dot" /><span>{d.long(lead.publishedAt)}</span></>}
+            <div className="share-row"><Link className="share-btn" href={href(lead)}>Lire l’article</Link></div>
+          </div>
+        </div>
+      </article>
+
+      {live && live.article.id !== lead.id && (
+        <div className="tv4-home-live">
+          <div className="more-header">
+            <span className="more-title"><span className="live-dot" /> En direct</span>
+            <div className="more-rule" />
+          </div>
+          <Link className="tv4-home-live-title" href={href(live.article)}>{live.article.title}</Link>
+          <ul className="tv4-home-live-list">
+            {live.entries.slice(0, 4).map((e) => (
+              <li key={e.id}><span className="tv4-time">{d.time(e.publishedAt)}</span> {e.title || e.body.replace(/<[^>]+>/g, "").slice(0, 140)}</li>
+            ))}
+          </ul>
+        </div>
+      )}
+
+      <More title="Dernières infos" cards={cards} site={site} />
+    </>
+  );
+}
+
+function Article({ site, article, related, liveNode, reactionsNode }: ArticleProps) {
+  const d = dates(site);
+  const lieu = article.fields.lieu;
+  const crumbs = [{ label: "Accueil", href: "/" }];
+  if (article.category) crumbs.push({ label: article.category.name, href: `/rubrique/${article.category.slug}` });
+
+  return (
+    <>
+      <Breadcrumb items={[...crumbs, { label: `${article.title.slice(0, 60)}${article.title.length > 60 ? "…" : ""}${article.publishedAt ? ` — ${d.long(article.publishedAt)}` : ""}` }]} />
+
+      <article className="article-card">
+        {article.media && <div className="hero-wrap has-img"><Img media={article.media} eager /></div>}
+        {article.media && captionOf(article) && <p className="hero-caption">{captionOf(article)}</p>}
+
+        <div className="article-head">
+          <p className="article-kicker">
+            {article.urgent && <span className="tv4-badge">Alerte</span>}
+            {article.live && <span className="tv4-badge">Direct</span>}
+            {article.category ? <Link href={`/rubrique/${article.category.slug}`}>{article.category.name}</Link> : site.name}
+          </p>
+          <h1 className="article-headline">{article.title}</h1>
+          {article.standfirst && <p className="article-deck">{article.standfirst}</p>}
+          <div className="article-meta">
+            <span className="meta-source">{site.name}</span>
+            {article.authorName && <><span className="meta-dot" /><span>{article.authorName}</span></>}
+            {lieu && <><span className="meta-dot" /><span>{lieu}</span></>}
+            {article.publishedAt && <><span className="meta-dot" /><span>{d.long(article.publishedAt)}, {d.time(article.publishedAt)}</span></>}
+            <div className="share-row">
+              <span className="share-btn" aria-hidden="true">X</span>
+              <span className="share-btn" aria-hidden="true">Facebook</span>
+              <CopyLink className="share-btn" label="Copier le lien" done="Lien copié" />
+            </div>
+          </div>
+        </div>
+
+        {liveNode && <div className="tv4-live">{liveNode}</div>}
+
+        <div className="article-body" dangerouslySetInnerHTML={{ __html: article.body }} />
+
+        {article.tags.length > 0 && (
+          <div className="article-tags">
+            <span className="tags-label">Tags:</span>
+            {article.tags.map((t) => <Link key={t.slug} className="tag" href={`/recherche?q=${encodeURIComponent(t.name)}`}>{t.name}</Link>)}
+          </div>
+        )}
+      </article>
+
+      <More title="À lire également" cards={related.slice(0, 3)} site={site} />
+
+      <div className="tv4-reactions">{reactionsNode}</div>
+    </>
+  );
+}
+
+function List({ site, title, subtitle, cards, emptyNote, pager, search }: ListProps) {
+  return (
+    <>
+      <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: title }]} />
+      {search && (
+        <form className="tv4-search-big" action="/recherche" method="get" role="search">
+          <input type="search" name="q" defaultValue={search.q} placeholder="Un mot, un nom, un lieu…" aria-label="Rechercher un article" />
+          <button type="submit">Rechercher</button>
+        </form>
+      )}
+      <div className="more-section tv4-list">
+        <div className="more-header">
+          <span className="more-title">{title}</span>
+          <div className="more-rule" />
+          {subtitle && <span className="tv4-count">{subtitle}</span>}
+        </div>
+        {cards.length === 0
+          ? <p className="tv4-note">{emptyNote}</p>
+          : <div className="more-grid">{cards.map((c) => <MoreCard key={c.id} card={c} site={site} />)}</div>}
+      </div>
+      {pager && (
+        <nav className="tv4-pager" aria-label="Pagination">
+          {pager.prev ? <Link href={pager.prev}>&#8249; Page précédente</Link> : <span />}
+          <span>{pager.label}</span>
+          {pager.next ? <Link href={pager.next}>Page suivante &#8250;</Link> : <span />}
+        </nav>
+      )}
+    </>
+  );
+}
+
+function Page({ site, title, html, updatedAt }: PageProps) {
+  const d = dates(site);
+  return (
+    <>
+      <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: title }]} />
+      <article className="article-card">
+        <div className="article-head">
+          <p className="article-kicker">{site.name}</p>
+          <h1 className="article-headline">{title}</h1>
+          <div className="article-meta"><span>Mise à jour le {d.long(updatedAt)}</span></div>
+        </div>
+        <div className="article-body" dangerouslySetInnerHTML={{ __html: html }} />
+      </article>
+    </>
+  );
+}
+
+export const tv4: SkinViews = { Shell, Home, Article, List, Page };
