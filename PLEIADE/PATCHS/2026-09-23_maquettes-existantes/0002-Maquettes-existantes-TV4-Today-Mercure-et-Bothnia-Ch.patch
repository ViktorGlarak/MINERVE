+        {card.standfirst && <p className="tm-row-deck">{card.standfirst}</p>}
+        {card.publishedAt && <div className="rel-date">{d.long(card.publishedAt)}{card.authorName ? ` · ${card.authorName}` : ""}</div>}
+      </div>
+    </div>
+  );
+}
+
+function Home({ site, lead, cards }: HomeProps) {
+  if (!lead) {
+    return <div className="article-body tm-empty"><div className="article-kicker">{site.name}</div><p className="article-deck">No dispatch has been published yet.</p></div>;
+  }
+  return (
+    <>
+      <article>
+        {lead.media && <Link className="article-hero" href={href(lead)} tabIndex={-1} aria-hidden="true"><Img media={lead.media} eager /></Link>}
+        {lead.media && captionOf(lead) && <div className="article-hero-caption">{captionOf(lead)}</div>}
+        <div className="article-body">
+          <div className="article-header">
+            <Kicker card={lead} />
+            <h1 className="article-headline"><Link href={href(lead)}>{lead.title}</Link></h1>
+            {lead.standfirst && <p className="article-deck">{lead.standfirst}</p>}
+            <Meta site={site} card={lead} />
+          </div>
+          <Link className="tm-readmore" href={href(lead)}>Read the full dispatch →</Link>
+        </div>
+      </article>
+
+      {cards.length > 0 && (
+        <section className="tm-section">
+          <div className="widget-title">Latest dispatches</div>
+          <div className="tm-rows">{cards.map((c) => <Row key={c.id} site={site} card={c} />)}</div>
+        </section>
+      )}
+    </>
+  );
+}
+
+function Article({ site, article, related, liveNode, reactionsNode }: ArticleProps) {
+  return (
+    <>
+      <article>
+        {article.media && <div className="article-hero"><Img media={article.media} eager /></div>}
+        {article.media && captionOf(article) && <div className="article-hero-caption">{captionOf(article)}</div>}
+
+        <div className="article-body">
+          <div className="article-header">
+            <Kicker card={article} />
+            <h1 className="article-headline">{article.title}</h1>
+            {article.standfirst && <p className="article-deck">{article.standfirst}</p>}
+            <Meta site={site} card={article} lieu={article.fields.lieu} share />
+          </div>
+
+          {liveNode && <div className="tm-live">{liveNode}</div>}
+
+          <div className="article-content">
+            <div dangerouslySetInnerHTML={{ __html: article.body }} />
+            {article.tags.length > 0 && (
+              <div className="article-tags">
+                {article.tags.map((t) => <Link key={t.slug} className="tag" href={`/recherche?q=${encodeURIComponent(t.name)}`}>{t.name}</Link>)}
+              </div>
+            )}
+          </div>
+        </div>
+      </article>
+
+      {related.length > 0 && (
+        <section className="tm-section">
+          <div className="widget-title">Related dispatches</div>
+          <div className="widget-body tm-related"><RelatedList site={site} cards={related.slice(0, 4)} /></div>
+        </section>
+      )}
+
+      <div className="tm-reactions">{reactionsNode}</div>
+    </>
+  );
+}
+
+function List({ site, title, subtitle, cards, emptyNote, pager, search }: ListProps) {
+  return (
+    <>
+      <div className="article-body tm-list-head">
+        <div className="article-kicker">{site.name}</div>
+        <h1 className="article-headline">{title}</h1>
+        {subtitle && <div className="tm-count">{subtitle}</div>}
+        {search && (
+          <form className="tm-search" action="/recherche" method="get" role="search">
+            <input type="search" name="q" defaultValue={search.q} placeholder="Search dispatches…" aria-label="Search" />
+            <button type="submit">Search</button>
+          </form>
+        )}
+      </div>
+      <section className="tm-section">
+        {cards.length === 0
+          ? <div className="tm-note">{emptyNote}</div>
+          : <div className="tm-rows">{cards.map((c) => <Row key={c.id} site={site} card={c} />)}</div>}
+      </section>
+      {pager && (
+        <nav className="tm-pager" aria-label="Pagination">
+          {pager.prev ? <Link href={pager.prev}>‹ Previous</Link> : <span />}
+          <span>{pager.label}</span>
+          {pager.next ? <Link href={pager.next}>Next ›</Link> : <span />}
+        </nav>
+      )}
+    </>
+  );
+}
