+import Link from "next/link";
+import type { Card, LiveItem } from "@/components/site/data";
+import type { SiteConfig } from "@/lib/site";
+import { CopyLink, NavLink } from "../client";
+import { Img, Notice, captionOf, dates, domainOf, href, skinRoot } from "../shared";
+import type { ArticleProps, HomeProps, ListProps, PageProps, ShellProps, SkinViews } from "../types";
+
+/**
+ * Bothnia Channel 1 — television publique d'Etat.
+ *
+ * Reprise de Sites/Site Bella Channel 1/_TEMPLATE.html (le dossier garde son
+ * ancien nom, le media s'appelle desormais Bothnia Channel 1) : barre de date
+ * et de langues, en-tete marine au logo BC1 encadre de rouge, recherche et
+ * pastille « live », navigation, bandeau « Breaking » rouge, grille article +
+ * colonne de 310px (« Live Updates », « Related Articles »), pied marine.
+ */
+
+/** Le monogramme : les initiales du nom, le chiffre final en rouge (« BC1 »). */
+function Monogram({ name }: { name: string }) {
+  const words = name.trim().split(/\s+/).filter(Boolean);
+  const letters = words.map((w) => (/^\d+$/.test(w) ? w : w[0].toUpperCase())).join("").slice(0, 4) || "BC1";
+  const m = letters.match(/^(.*?)(\d+)$/);
+  return m ? <>{m[1]}<span className="one">{m[2]}</span></> : <>{letters}</>;
+}
+
+function strip(html: string): string {
+  return html.replace(/<[^>]+>/g, " ").replace(/\s+/g, " ").trim();
+}
+
+function Related({ site, cards }: { site: SiteConfig; cards: Card[] }) {
+  const d = dates(site);
+  return (
+    <>
+      {cards.map((c) => (
+        <div key={c.id} className="related-item">
+          <Link className="related-thumb" href={href(c)} tabIndex={-1} aria-hidden="true">
+            {c.media ? <Img media={c.media} /> : (
+              <svg width="28" height="28" viewBox="0 0 28 28" fill="none"><circle cx="14" cy="10" r="5" fill="#A8A8A8" /><path d="M4 24C4 19 8.5 16 14 16C19.5 16 24 19 24 24" stroke="#A8A8A8" strokeWidth="2" strokeLinecap="round" /></svg>
+            )}
+          </Link>
+          <div>
+            {c.category && <div className="rel-cat">{c.category.name}</div>}
+            <Link className="rel-title" href={href(c)}>{c.title}</Link>
+            {c.publishedAt && <div className="rel-date">{d.long(c.publishedAt)}</div>}
+          </div>
+        </div>
+      ))}
+    </>
+  );
+}
+
+function LiveUpdates({ site, live, entries, latest }: { site: SiteConfig; live: Card | null; entries: LiveItem[]; latest: Card[] }) {
+  const d = dates(site);
+  return (
+    <div className="widget">
+      <div className="widget-title">Live Updates</div>
+      <div className="widget-body">
+        {live && entries.length > 0 ? (
+          <>
+            <Link className="bc1-widget-link" href={href(live)}>{live.title}</Link>
+            {entries.slice(0, 6).map((e) => (
+              <div key={e.id} className="feed-item">
+                <div className="feed-time">{d.time(e.publishedAt)}</div>
+                {e.title || strip(e.body).slice(0, 160)}
+              </div>
+            ))}
+          </>
+        ) : latest.length > 0 ? (
+          latest.slice(0, 6).map((c) => (
+            <div key={c.id} className="feed-item">
+              <div className="feed-time">{c.publishedAt ? d.time(c.publishedAt) : "—"}</div>
+              <Link href={href(c)}>{c.title}</Link>
+            </div>
+          ))
+        ) : (
+          <div className="feed-item">No update published yet.</div>
+        )}
+      </div>
+    </div>
+  );
+}
+
+function Shell({ site, nav, pages, ticker, live, liveEntries, latest, children }: ShellProps) {
+  const root = skinRoot(site, "bc1");
+  const d = dates(site);
+  const now = new Date();
+  const domaine = domainOf(site.baseline) || domainOf(site.footerText);
+  const pastille = live?.title ?? ticker[0]?.title ?? "";
+
+  return (
+    <div className={root.className} style={root.style}>
+      <Notice site={site} />
+
+      <div className="top-bar">
+        <div className="top-bar-inner">
+          <span className="top-bar-date">{d.full(now)} &nbsp;·&nbsp; {d.time(now)}</span>
+          <div className="lang-switch" aria-hidden="true">
+            <span className="active">EN</span><span>RU</span><span>BY</span>
+          </div>
+        </div>
+      </div>
+
+      <header className="site-header">
+        <div className="header-inner">
+          <Link className="bc1-logo" href="/">
+            {site.logoUrl
+              // eslint-disable-next-line @next/next/no-img-element
+              ? <img className="bc1-logo-img" src={site.logoUrl} alt={site.name} />
+              : <span className="bc1-logo-text"><Monogram name={site.name} /></span>}
+          </Link>
+          <div className="site-branding">
+            <div className="site-name-main">{site.name}</div>
+            {site.baseline && <div className="site-name-sub">{site.baseline}</div>}
+          </div>
+          <div className="header-right">
+            <form className="search-bar" action="/recherche" method="get" role="search">
+              <input type="search" name="q" placeholder="Search articles..." aria-label="Search articles" />
+              <button type="submit">Search</button>
+            </form>
+            {pastille && (
+              <Link className="live-badge" href={live ? href(live) : "/direct"}>
+                <span className="live-dot" />{pastille}
+              </Link>
+            )}
+          </div>
+        </div>
+      </header>
+
+      <nav className="main-nav" aria-label="Sections">
+        <div className="nav-inner">
+          <NavLink href="/">Home</NavLink>
+          {nav.map((m) => <NavLink key={`${m.href}-${m.label}`} href={m.href}>{m.label}</NavLink>)}
+          <NavLink href="/direct">Live</NavLink>
+        </div>
+      </nav>
+
+      {ticker.length > 0 && (
+        <div className="ticker-bar">
+          <div className="ticker-label"><span className="ticker-dot" />Breaking</div>
+          <div className="ticker-scroll">
+            <span className="ticker-content">
+              {ticker.map((t, i) => (
+                <span key={t.slug}>
+                  {i > 0 && <>&nbsp;<span className="tick-sep">|</span>&nbsp;</>}
+                  <Link href={`/article/${t.slug}`}>{t.title}</Link>
+                </span>
+              ))}
+            </span>
+          </div>
+        </div>
+      )}
+
+      <div className="page-wrap">
+        <main className="bc1-main" id="contenu">{children}</main>
+        <aside className="sidebar">
+          <LiveUpdates site={site} live={live} entries={liveEntries} latest={latest} />
+          {latest.length > 0 && (
+            <div className="widget">
+              <div className="widget-title">Latest Articles</div>
+              <div className="widget-body"><Related site={site} cards={latest.slice(0, 5)} /></div>
+            </div>
+          )}
+        </aside>
+      </div>
+
+      <footer className="site-footer">
+        <div className="footer-inner">
+          <div className="footer-top">
+            <div className="footer-brand">
+              <div className="footer-bc1"><span className="footer-bc1-text"><Monogram name={site.name} /></span></div>
+              <div>
+                <div className="footer-name-main">{site.name}</div>
+                <div className="footer-name-sub">{site.description || domaine}</div>
+              </div>
+            </div>
+            <div className="footer-links">
+              {pages.map((p) => <Link key={p.slug} href={`/page/${p.slug}`}>{p.title}</Link>)}
+              <Link href="/direct">Live Stream</Link>
+            </div>
+          </div>
+          <div className="footer-bottom">{site.footerText || `© ${now.getFullYear()} ${site.name}`}</div>
+        </div>
+      </footer>
+    </div>
+  );
+}
+
+function Kicker({ card }: { card: Card }) {
+  return (
+    <div className="article-kicker">
+      {card.urgent && <span className="bc1-badge">Breaking</span>}
+      {card.live && <span className="bc1-badge">Live</span>}
+      {card.category ? <Link href={`/rubrique/${card.category.slug}`}>{card.category.name}</Link> : "News"}
+    </div>
+  );
+}
+
+function Meta({ site, card, lieu, share }: { site: SiteConfig; card: Card; lieu?: string; share?: boolean }) {
+  const d = dates(site);
+  return (
+    <div className="article-meta">
+      <span className="meta-source">{card.authorName || `${site.name} Desk`}</span>
+      {lieu && <><span className="meta-sep">/</span><span>{lieu}</span></>}
+      {card.publishedAt && <><span className="meta-sep">/</span><span>{d.long(card.publishedAt)}, {d.time(card.publishedAt)}</span></>}
+      {share && (
+        <div className="meta-social">
+          <CopyLink className="social-btn" label="Share" done="Link copied" />
+          <span className="social-btn" aria-hidden="true">VK</span>
+          <span className="social-btn" aria-hidden="true">Telegram</span>
+        </div>
+      )}
+    </div>
+  );
+}
+
+function Row({ site, card }: { site: SiteConfig; card: Card }) {
+  const d = dates(site);
+  return (
+    <div className="bc1-row">
+      <Link className="bc1-row-thumb" href={href(card)} tabIndex={-1} aria-hidden="true"><Img media={card.media} /></Link>
+      <div>
+        <Kicker card={card} />
+        <Link className="bc1-row-title" href={href(card)}>{card.title}</Link>
+        {card.standfirst && <p className="bc1-row-deck">{card.standfirst}</p>}
+        {card.publishedAt && <div className="rel-date">{d.long(card.publishedAt)}</div>}
+      </div>
+    </div>
+  );
+}
+
+function Home({ site, lead, cards }: HomeProps) {
+  if (!lead) {
+    return <div className="article-card"><div className="article-body"><div className="article-kicker">{site.name}</div><p className="article-deck">No article has been published yet.</p></div></div>;
+  }
+  return (
+    <>
+      <article className="article-card">
+        {lead.media && <Link className="article-hero" href={href(lead)} tabIndex={-1} aria-hidden="true"><Img media={lead.media} eager /></Link>}
