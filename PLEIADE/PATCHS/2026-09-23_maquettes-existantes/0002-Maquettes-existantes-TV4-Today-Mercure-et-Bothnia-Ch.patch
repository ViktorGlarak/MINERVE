@@ -0,0 +1,77 @@
+import type { ReactNode } from "react";
+import type { MenuItem } from "@/lib/homepage";
+import type { SiteConfig } from "@/lib/site";
+import type { ArticleFull, Card, LiveItem } from "@/components/site/data";
+
+/**
+ * Le contrat d'un habillage. Les pages du site public vont chercher les donnees
+ * (elles savent parler a la base), puis passent la main a l'habillage, qui ne
+ * fait que les mettre en page. Un habillage ne lit donc jamais la base : c'est
+ * ce qui permet aussi de le rendre dans l'apercu des reglages, cote navigateur,
+ * avec de faux articles.
+ */
+
+export interface TickerItem {
+  slug: string;
+  title: string;
+}
+
+export interface ShellProps {
+  site: SiteConfig;
+  nav: MenuItem[];
+  pages: Array<{ slug: string; title: string }>;
+  /** le bandeau defilant : les alertes, sinon les derniers titres */
+  ticker: TickerItem[];
+  /** l'article suivi en direct, s'il y en a un, et ses dernieres entrees */
+  live: Card | null;
+  liveEntries: LiveItem[];
+  /** les derniers articles, pour les colonnes laterales */
+  latest: Card[];
+  children: ReactNode;
+}
+
+export interface HomeProps {
+  site: SiteConfig;
+  lead: Card | null;
+  cards: Card[];
+  live: { article: Card; entries: LiveItem[] } | null;
+}
+
+export interface ArticleProps {
+  site: SiteConfig;
+  article: ArticleFull;
+  /** meme rubrique, sinon la suite de l'actualite */
+  related: Card[];
+  /** le fil en direct, deja monte (il se rafraichit seul) */
+  liveNode: ReactNode | null;
+  /** les reactions et leur formulaire, deja montes */
+  reactionsNode: ReactNode;
+  /** les dernieres entrees de fil, pour les colonnes laterales */
+  entries: LiveItem[];
+}
+
+export interface ListProps {
+  site: SiteConfig;
+  title: string;
+  subtitle?: string;
+  cards: Card[];
+  emptyNote: string;
+  pager?: { prev?: string; next?: string; label: string };
+  /** la page de recherche montre son champ */
+  search?: { q: string };
+}
+
+export interface PageProps {
+  site: SiteConfig;
+  title: string;
+  html: string;
+  updatedAt: Date;
+}
+
+export interface SkinViews {
+  Shell: (p: ShellProps) => ReactNode;
+  Home: (p: HomeProps) => ReactNode;
+  Article: (p: ArticleProps) => ReactNode;
+  List: (p: ListProps) => ReactNode;
+  Page: (p: PageProps) => ReactNode;
+}
diff --git a/src/skins/views.ts b/src/skins/views.ts
new file mode 100644
