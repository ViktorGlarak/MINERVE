+/*
+  Les maquettes existantes (habillages de sites d'exercice).
+
+  Chaque habillage a sa feuille, confinee derriere .sk-<cle>. Ce fichier ne
+  tient que ce qu'ils partagent : les ilots, ces morceaux du site public
+  generique (mention d'exercice, reactions, fil en direct) poses tels quels
+  dans un habillage et repeints par ses jetons.
+*/
+
+@import "./tv4/tv4.css";
+@import "./todaymercure/todaymercure.css";
+@import "./bc1/bc1.css";
+
+/* Un ilot n'est pas une page : pas de hauteur d'ecran, pas de fond impose. */
+.sk .site.sk-island { min-height: 0; background: transparent; display: block; line-height: 1.55; }
+.sk .site.sk-island a { color: var(--accent); }
+.sk .sk-island .section-title { margin-top: 0; }
+
+/* La mention d'exercice garde exactement l'allure du site generique. */
+.sk .site.sk-notice { background: transparent; }
