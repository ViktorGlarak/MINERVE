+  );
+}
+
+function Kicker({ card }: { card: Card }) {
+  return (
+    <div className="article-kicker">
+      {card.urgent && <span className="tm-badge">Breaking</span>}
+      {card.live && <span className="tm-badge">Live</span>}
+      {card.category ? <Link href={`/rubrique/${card.category.slug}`}>{card.category.name}</Link> : "Dispatch"}
+    </div>
+  );
+}
+
+function Row({ site, card }: { site: SiteConfig; card: Card }) {
+  const d = dates(site);
+  return (
+    <div className="tm-row">
+      <Link className="tm-row-thumb" href={href(card)} tabIndex={-1} aria-hidden="true"><Img media={card.media} /></Link>
+      <div className="tm-row-body">
+        <Kicker card={card} />
